+import csv, sys, collections
+c = collections.Counter(); codes = collections.Counter(); thr = collections.Counter()
+for r in csv.DictReader(open(sys.argv[1])):
+    d = int(r['debugid']); codes['0x%08x' % d] += 1
+    if d & ~3 != 0x85210010: continue
+    ro = 'read-only' if int(r['arg3']) & 1 else 'write'
+    c[(r['execname'], int(r['arg2']), ro)] += 1
+    if r['execname'] == 'WindowServer': thr[(int(r['threadid']), ro)] += 1
+print('event codes:', dict(codes))
+print('locks by process / surface / kind:')
+for (p, s, k), n in sorted(c.items(), key=lambda x: -x[1]): print('  %-22s surface %-5d %-9s %d' % (p, s, k, n))
+print('WindowServer threads:', dict(thr))
