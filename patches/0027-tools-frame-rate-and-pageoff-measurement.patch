@@ -0,0 +1,79 @@
+// lockseed-test: does a user-space IOSurfaceLock reach the kernel's IOSurface::lockSurface (and bump its lock seed)?
+// Creates a surface, reads its kernel lock/unlock seeds through XeGfxAccel's DRM client (selector 3), locks it
+// read-only 3 times and read-write 2 times, and reads the seeds again.  Expect +5 locks if every lock goes through
+// the kernel (docs/36-APPLE-INTEL-DRIVER.md §36.9: what the accel's lock watch counts).
+// Build: clang -framework IOSurface -framework IOKit -framework CoreFoundation lockseed-test.c -o lockseed-test
+#include <IOKit/IOKitLib.h>
+#include <IOSurface/IOSurfaceRef.h>
+#include <CoreFoundation/CoreFoundation.h>
+#include <stdio.h>
+#include <string.h>
+
+static io_connect_t open_xgdr(void)
+{
+    io_service_t s = IOServiceGetMatchingService(kIOMainPortDefault, IOServiceMatching("NMXAccel"));
+    io_connect_t c = 0;
+    if (!s) return 0;
+    if (IOServiceOpen(s, mach_task_self(), 0x58474452u /* 'XGDR' */, &c) != KERN_SUCCESS) c = 0;
+    IOObjectRelease(s);
+    return c;
+}
+
+static int seeds(io_connect_t c, uint32_t id, uint64_t *ls, uint64_t *us)
+{
+    uint64_t in = id, out[2] = { 0, 0 };
+    uint32_t n = 2;
+    kern_return_t kr = IOConnectCallScalarMethod(c, 3, &in, 1, out, &n);
+    *ls = out[0]; *us = out[1];
+    return kr == KERN_SUCCESS;
+}
+
+// §36.12: with an observer device cache of the accel's made current (selector 4), a CPU lock should call its control
+// function: op 0 (page-off) then op 2 (wait); a second lock without making it current again should call nothing.
+static void dc(io_connect_t c, uint32_t id, const char *what)
+{
+    uint64_t in = id, out[3] = { 0, 0, 0 };
+    uint32_t n = 3;
+    kern_return_t kr = IOConnectCallScalarMethod(c, 4, &in, 1, out, &n);
+    printf("  %-44s kr 0x%x  page-off %llu  wait %llu  other %llu\n", what, kr, out[0], out[1], out[2]);
+}
+
+int main(int argc, char **argv)
+{
+    int w = 64, h = 64, bpe = 4;
+    CFNumberRef nw = CFNumberCreate(NULL, kCFNumberIntType, &w), nh = CFNumberCreate(NULL, kCFNumberIntType, &h),
+                nb = CFNumberCreate(NULL, kCFNumberIntType, &bpe);
+    const void *k[] = { kIOSurfaceWidth, kIOSurfaceHeight, kIOSurfaceBytesPerElement };
+    const void *v[] = { nw, nh, nb };
+    CFDictionaryRef p = CFDictionaryCreate(NULL, k, v, 3, &kCFTypeDictionaryKeyCallBacks, &kCFTypeDictionaryValueCallBacks);
+    IOSurfaceRef s = IOSurfaceCreate(p);
+    io_connect_t c = open_xgdr();
+    uint64_t l0, u0, l1, u1;
+    if (!s || !c) { fprintf(stderr, "surface %p, XGDR client %u\n", (void *)s, c); return 1; }
+    const uint32_t id = IOSurfaceGetID(s);
+    if (!seeds(c, id, &l0, &u0)) { fprintf(stderr, "selector 3 refused (old accel?)\n"); return 1; }
+    for (int i = 0; i < 3; i++) { IOSurfaceLock(s, kIOSurfaceLockReadOnly, NULL); IOSurfaceUnlock(s, kIOSurfaceLockReadOnly, NULL); }
+    for (int i = 0; i < 2; i++) { IOSurfaceLock(s, 0, NULL); ((volatile char *)IOSurfaceGetBaseAddress(s))[0] = (char)i; IOSurfaceUnlock(s, 0, NULL); }
+    seeds(c, id, &l1, &u1);
+    printf("surface %u: lock seed %llu -> %llu (+%llu), unlock seed %llu -> %llu (+%llu) after 3 read-only + 2 write locks\n",
+           id, l0, l1, l1 - l0, u0, u1, u1 - u0);
+    if (argc > 1 && !strcmp(argv[1], "--dc")) {
+        printf("device cache (selector 4; each call makes the cache current again and prints the counts before it):\n");
+        dc(c, id, "attach + current");
+        IOSurfaceLock(s, kIOSurfaceLockReadOnly, NULL); IOSurfaceUnlock(s, kIOSurfaceLockReadOnly, NULL);
+        IOSurfaceLock(s, kIOSurfaceLockReadOnly, NULL); IOSurfaceUnlock(s, kIOSurfaceLockReadOnly, NULL);
+        dc(c, id, "after 2 read-only locks (expect +1 page-off)");
+        IOSurfaceLock(s, 0, NULL); ((volatile char *)IOSurfaceGetBaseAddress(s))[1] = 7; IOSurfaceUnlock(s, 0, NULL);
+        dc(c, id, "after 1 write lock");
+        IOSurfaceLock(s, kIOSurfaceLockReadOnly, NULL); IOSurfaceUnlock(s, kIOSurfaceLockReadOnly, NULL);
+        dc(c, id, "after 1 read-only lock");
+        dc(c, id | 0x80000000u, "release our cache (bit 31)");
+        CFRelease(s); s = NULL;
+        IOSurfaceRef t = IOSurfaceCreate(p);
+        const uint32_t id2 = IOSurfaceGetID(t);
+        dc(c, id2, "another surface: attach + current");
+        dc(c, id2 | 0x80000000u, "release it again, no lock in between");
+        CFRelease(t);
+    }
+    return 0;
+}
