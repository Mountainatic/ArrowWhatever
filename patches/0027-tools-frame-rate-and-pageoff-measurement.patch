+import sys, re, subprocess
+base, prefs = sys.argv[1], sys.argv[2:]
+addrs = [int(l.split()[0], 16) for l in open(base + '.tsyms')]
+names = [l.rstrip('\n') for l in open(base + '.tsyms.d')]
+amap = dict(zip(addrs, names))
+dis = open(base + '.dis').read().splitlines()
+idx = []
+for k, l in enumerate(dis):
+    t = l.split('\t', 1)[0].strip()
+    try: idx.append((int(t, 16), k))
+    except ValueError: pass
+import bisect
+ia = [a for a, _ in idx]
+for pref in prefs:
+    for i, n in enumerate(names):
+        if not n.startswith(pref): continue
+        s, e = addrs[i], addrs[i + 1] if i + 1 < len(addrs) else 1 << 64
+        print('## %s (%d B)' % (n, e - s))
+        j = bisect.bisect_left(ia, s)
+        seen = []
+        while j < len(idx) and idx[j][0] < e:
+            l = dis[idx[j][1]]
+            m = re.search(r'literal pool for: "(.*)"', l)
+            if m: seen.append('  "' + m.group(1)[:150] + '"')
+            m = re.search(r'callq\s+0x([0-9a-f]+)', l)
+            if m:
+                t = int(m.group(1), 16)
+                if t in amap: seen.append('  -> ' + amap[t][:110])
+            m = re.search(r'callq\s+\*', l)
+            j += 1
+        out = []
+        for x in seen:
+            if not out or out[-1] != x: out.append(x)
+        print('\n'.join(out[:int(__import__('os').environ.get('N', '60'))]))
