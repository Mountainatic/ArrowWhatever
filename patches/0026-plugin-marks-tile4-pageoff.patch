+static void nvmtl_tile4_after_commit(XeMTLCommandBuffer *cb)
+{
+    static int ws = -1;
+    if (ws < 0) ws = getprogname() && !strcmp(getprogname(), "WindowServer");
+    if (!ws) return;
+    NSMutableArray *roots = nil; NSMutableArray *wants = nil;
+    for (XeMTLSubmissionPart *part in cb->_parts) {
+        if (![part isKindOfClass:[XeMTLSubmissionPart class]]) continue;
+        for (XeMTLTexture *t in part->surfaces) {
+            XeMTLTexture *r = t->_parent ? t->_parent : t;
+            if (r->_po && r->_surf && !r->_hostImg && ![roots containsObject:r] &&
+                (r->_poDemote || nvmtl_vk_is_scanout((uint32_t)IOSurfaceGetID(r->_surf)))) {   // <wtl> §36.12
+                if (!roots) { roots = [NSMutableArray new]; wants = [NSMutableArray new]; }
+                [roots addObject:r]; [wants addObject:@(-1)]; continue;
+            }
+            if (r->_poCand && r->_hostImg && !r->_tile4 && ![roots containsObject:r] && ++r->_poDraws >= 100 &&   // <wtl> §36.12
+                clock_gettime_nsec_np(CLOCK_UPTIME_RAW) - r->_poBornNs >= 3000000000ull) {
+                if (!roots) { roots = [NSMutableArray new]; wants = [NSMutableArray new]; }
+                [roots addObject:r]; [wants addObject:@(-2)]; continue;
+            }
+            if (!r->_surf || !r->_hostImg || r->_vramOn || [roots containsObject:r]) continue;
+            const int want = nvmtl_tile4_want(r->_surf, r->_plane, r->_i.w, r->_i.h, r->_i.fmt);
+            if (want == (r->_tile4 ? 1 : 0)) continue;
+            if (!roots) { roots = [NSMutableArray new]; wants = [NSMutableArray new]; }
+            [roots addObject:r]; [wants addObject:@(want)];
+        }
+    }
+    for (NSUInteger i = 0; i < roots.count; i++) {
+        if ([wants[i] intValue] == -2) {   // <wtl> §36.12
+            XeMTLTexture *r = roots[i]; const uint32_t sid = IOSurfaceGetID(r->_surf);
+            if (nvmtl_vk_po_on() && !nvmtl_vk_is_scanout(sid) && !nvmtl_po_denied(r->_surf) && !nvmtl_roots_others(r->_surf, r)) nvmtl_po_promote(r);
+            else r->_poCand = NO;
+        } else if ([wants[i] intValue] < 0) nvmtl_po_demote(roots[i]);   // <wtl> §36.12
+        else nvmtl_tile4_inplace(roots[i], [wants[i] intValue]);
+    }
+}
