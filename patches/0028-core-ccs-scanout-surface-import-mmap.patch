+ * DRM_IOCTL_I915_GEM_USERPTR on a file with an announcement for exactly this pointer and size: the object is made of
+ * the surface's memory.  -ENOENT when nothing matches (the ioctl goes on to i915 as a plain userptr).
+ */
+static int
+xg_surf_userptr(struct file *filp, void *key, struct drm_i915_gem_userptr *u)
+{
+	static struct lock_class_key lock_class;
+	struct drm_file *file = filp->private_data;
+	struct drm_device *dev = file->minor->dev;
+	struct xg_ticket *t = NULL, *e;
+	struct drm_i915_gem_object *obj;
+	struct xg_surfobj *so;
+	const u64 t0 = ktime_get_ns();
+	unsigned int npages, n = 0;
+	u32 handle = 0;
+	int err;
+
+	mutex_lock(&xg_surf_lock);
+	list_for_each_entry(e, &xg_expects, link)
+		if (e->key == key && e->user_ptr == u->user_ptr && e->user_size == u->user_size) {
+			list_del(&e->link);
+			t = e;
+			break;
+		}
+	mutex_unlock(&xg_surf_lock);
+	if (t == NULL)
+		return -ENOENT;
+	npages = (unsigned int)(t->user_size >> PAGE_SHIFT);
+	so = kzalloc(sizeof(*so), GFP_KERNEL);
+	if (so != NULL) {
+		so->pa = kvcalloc(npages, sizeof(*so->pa), GFP_KERNEL);
+		so->len = kvcalloc(npages, sizeof(*so->len), GFP_KERNEL);
+	}
+	if (so == NULL || so->pa == NULL || so->len == NULL ||
+	    xg_md_prepare_ranges(t->md, t->user_size, so->pa, so->len, npages, &n) != 0) {
+		if (so != NULL) {
+			kvfree(so->pa);
+			kvfree(so->len);
+			kfree(so);
+		}
+		xg_md_drop(t->md, 0);
+		kfree(t);
+		xg_surf_fail++;
+		return -ENOENT;	/* a plain userptr after all */
+	}
+	so->md = t->md;
+	so->n = n;
+	kfree(t);
+	obj = i915_gem_object_alloc();
+	if (obj == NULL) {
+		xg_md_drop(so->md, 1);
+		kvfree(so->pa);
+		kvfree(so->len);
+		kfree(so);
+		xg_surf_fail++;
+		return -ENOMEM;
+	}
+	drm_gem_private_object_init(dev, &obj->base, npages << PAGE_SHIFT);
+	i915_gem_object_init(obj, &xg_surf_ops, &lock_class, I915_BO_ALLOC_USER);
+	obj->mem_flags = 0;	/* no struct pages: nothing maps, kmaps or clflushes it */
+	obj->read_domains = I915_GEM_DOMAIN_CPU | I915_GEM_DOMAIN_GTT;
+	obj->write_domain = 0;
+	i915_gem_object_set_cache_coherency(obj, I915_CACHE_LLC);	/* as a userptr: the CPU's pages, snooped */
+	if (u->flags & I915_USERPTR_READ_ONLY)
+		i915_gem_object_set_readonly(obj);
+	so->obj = obj;
+	mutex_lock(&xg_surf_lock);
+	list_add_tail(&so->link, &xg_surfobjs);
+	mutex_unlock(&xg_surf_lock);
+	xg_surf_live++;
+	err = drm_gem_handle_create(file, &obj->base, &handle);
+	i915_gem_object_put(obj);	/* the handle holds it now; on error this frees it (xg_surf_release) */
+	if (err) {
+		xg_surf_fail++;
+		return err;
+	}
+	u->handle = handle;
+	xg_surf_imports++;
+	xg_surf_pages += npages;
+	xg_surf_ranges += n;
+	xg_surf_ns += ktime_get_ns() - t0;
+	return 0;
+}
+
+/* a closing file's announcements go with it */
+static void
+xg_surf_close(void *key)
+{
+	struct xg_ticket *e, *et;
+	LIST_HEAD(gone);
+
+	mutex_lock(&xg_surf_lock);
+	list_for_each_entry_safe(e, et, &xg_expects, link)
+		if (e->key == key)
+			list_move(&e->link, &gone);
+	mutex_unlock(&xg_surf_lock);
+	xg_surf_drop_list(&gone);
+}
