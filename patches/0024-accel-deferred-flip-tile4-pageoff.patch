+SYSCTL_QUAD(_debug, OID_AUTO, nvaccel_iop_xe_early_hazards, CTLFLAG_RD | CTLFLAG_LOCKED, &gCntXeEarlyHazards, "E2: frames on the surface scanned during the previous early-signalled arm");
