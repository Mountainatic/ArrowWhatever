@@ -0,0 +1,124 @@
+// pass-bench: GPU time of one WindowServer-like composite pass (3840x2400 BGRA8, load action Load, a full-screen quad
+// that samples a 3840x2400 source and blends over the target) on XeMTL, with the target and the source each either an
+// IOSurface-backed texture (what WindowServer renders into and samples) or a private texture.  Wall time per pass over
+// N passes with one wait at the end, so it is the GPU throughput.  Read-only.
+// Build: clang -fobjc-arc -framework Foundation -framework Metal -framework IOSurface pass-bench.m -o pass-bench
+// Usage: pass-bench [passes=60] [width=3840] [height=2400]
+#import <Foundation/Foundation.h>
+#import <Metal/Metal.h>
+#import <IOSurface/IOSurface.h>
+#include <mach/mach_time.h>
+
+static const char *kSrc =
+    "#include <metal_stdlib>\nusing namespace metal;\n"
+    "struct V { float4 p [[position]]; float2 uv; };\n"
+    "vertex V vs(uint i [[vertex_id]]) { float2 q = float2((i << 1) & 2, i & 2); V v; v.p = float4(q * 2 - 1, 0, 1); v.uv = float2(q.x, 1 - q.y); return v; }\n"
+    "fragment float4 fs_tex(V v [[stage_in]], texture2d<float> t [[texture(0)]], sampler s [[sampler(0)]]) { return t.sample(s, v.uv) * 0.5; }\n"
+    "fragment float4 fs_fill(V v [[stage_in]]) { return float4(0.2, 0.4, 0.6, 0.5); }\n";
+
+static double now(void)
+{
+    static mach_timebase_info_data_t tb;
+    if (!tb.denom) mach_timebase_info(&tb);
+    return (double)mach_absolute_time() * tb.numer / tb.denom / 1e6;
+}
+
+// kind 0 private (tiled), 1 IOSurface (linear, the surface's own pages), 2/3 linear in a private/shared MTLBuffer
+static id<MTLTexture> tex(id<MTLDevice> d, int w, int h, int surface)
+{
+    MTLTextureDescriptor *td = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatBGRA8Unorm width:w height:h mipmapped:NO];
+    td.usage = MTLTextureUsageRenderTarget | MTLTextureUsageShaderRead;
+    if (!surface) { td.storageMode = MTLStorageModePrivate; return [d newTextureWithDescriptor:td]; }
+    if (surface >= 2) {
+        const NSUInteger rb = ((NSUInteger)w * 4 + 255) & ~(NSUInteger)255;
+        id<MTLBuffer> b = [d newBufferWithLength:rb * h options:surface == 2 ? MTLResourceStorageModePrivate : MTLResourceStorageModeShared];
+        td.storageMode = surface == 2 ? MTLStorageModePrivate : MTLStorageModeShared;
+        return [b newTextureWithDescriptor:td offset:0 bytesPerRow:rb];
+    }
+    NSDictionary *p = @{ (id)kIOSurfaceWidth: @(w), (id)kIOSurfaceHeight: @(h), (id)kIOSurfaceBytesPerElement: @4,
+                         (id)kIOSurfacePixelFormat: @((unsigned)'BGRA'), (id)kIOSurfaceBytesPerRow: @(((w * 4) + 63) & ~63) };
+    IOSurfaceRef s = IOSurfaceCreate((__bridge CFDictionaryRef)p);
+    td.storageMode = MTLStorageModeManaged;
+    id<MTLTexture> t = [d newTextureWithDescriptor:td iosurface:s plane:0];
+    CFRelease(s);
+    return t;
+}
+
+int main(int argc, char **argv)
+{
+    @autoreleasepool {
+        const int n = argc > 1 ? atoi(argv[1]) : 60, w = argc > 2 ? atoi(argv[2]) : 3840, h = argc > 3 ? atoi(argv[3]) : 2400;
+        id<MTLDevice> d = nil;   // the Intel GPU WindowServer composites on, not the default (discrete) device
+        for (id<MTLDevice> x in MTLCopyAllDevices()) {
+            printf("device: %s\n", x.name.UTF8String);
+            if (!d && ([x.name containsString:@"Intel"] || [x.name containsString:@"Xe"])) d = x;
+        }
+        if (!d) { fprintf(stderr, "no Intel device\n"); return 1; }
+        NSError *e = nil;
+        id<MTLLibrary> lib = [d newLibraryWithSource:@(kSrc) options:nil error:&e];
+        if (!lib) { fprintf(stderr, "library: %s\n", e.description.UTF8String); return 1; }
+        id<MTLRenderPipelineState> ps[2];
+        for (int k = 0; k < 2; k++) {
+            MTLRenderPipelineDescriptor *pd = [MTLRenderPipelineDescriptor new];
+            pd.vertexFunction = [lib newFunctionWithName:@"vs"];
+            pd.fragmentFunction = [lib newFunctionWithName:k ? @"fs_fill" : @"fs_tex"];
+            pd.colorAttachments[0].pixelFormat = MTLPixelFormatBGRA8Unorm;
+            pd.colorAttachments[0].blendingEnabled = YES;
+            pd.colorAttachments[0].sourceRGBBlendFactor = pd.colorAttachments[0].sourceAlphaBlendFactor = MTLBlendFactorOne;
+            pd.colorAttachments[0].destinationRGBBlendFactor = pd.colorAttachments[0].destinationAlphaBlendFactor = MTLBlendFactorOneMinusSourceAlpha;
+            ps[k] = [d newRenderPipelineStateWithDescriptor:pd error:&e];
+            if (!ps[k]) { fprintf(stderr, "pipeline: %s\n", e.description.UTF8String); return 1; }
+        }
+        id<MTLSamplerState> smp = [d newSamplerStateWithDescriptor:[MTLSamplerDescriptor new]];
+        id<MTLCommandQueue> q = [d newCommandQueue];
+        id<MTLBuffer> noise = [d newBufferWithLength:(NSUInteger)w * h * 4 options:MTLResourceStorageModeShared];
+        { uint32_t *p = noise.contents, x = 2463534242u; for (size_t i = 0; i < (size_t)w * h; i++) { x ^= x << 13; x ^= x >> 17; x ^= x << 5; p[i] = x; } }
+        void (^fill)(id<MTLTexture>) = ^(id<MTLTexture> t) {
+            id<MTLCommandBuffer> cb = [q commandBuffer]; id<MTLBlitCommandEncoder> b = [cb blitCommandEncoder];
+            [b copyFromBuffer:noise sourceOffset:0 sourceBytesPerRow:w * 4 sourceBytesPerImage:(NSUInteger)w * h * 4 sourceSize:MTLSizeMake(w, h, 1)
+                    toTexture:t destinationSlice:0 destinationLevel:0 destinationOrigin:MTLOriginMake(0, 0, 0)];
+            [b endEncoding]; [cb commit]; [cb waitUntilCompleted];
+        };
+        const int layers = getenv("LAYERS") ? atoi(getenv("LAYERS")) : 4;
+        printf("%s, %dx%d, %d passes each, %d full-screen layers per pass, random content\n", d.name.UTF8String, w, h, n, layers);
+        const char *nm[4] = { "private", "iosurface", "linbuf-prv", "linbuf-shr" };
+        for (int round = 0; round < 1; round++) for (int shader = 1; shader >= 0; shader--)
+            for (int dst = 0; dst < 4; dst++)
+                for (int src = 0; src < (shader ? 1 : 2); src++) {
+                    id<MTLTexture> T = tex(d, w, h, dst), S = shader ? nil : tex(d, w, h, src);
+                    if (!T) { printf("%-9s target: not available\n", nm[dst]); continue; }
+                    fill(T); if (S) fill(S);
+                    double best = 1e9, gpu = -1;
+                    for (int rep = 0; rep < 3; rep++) {
+                        double t0 = now();
+                        id<MTLCommandBuffer> last = nil;
+                        NSMutableArray *all = [NSMutableArray new];
+                        for (int i = 0; i < n; i++) {
+                            id<MTLCommandBuffer> cb = [q commandBuffer];
+                            MTLRenderPassDescriptor *rp = [MTLRenderPassDescriptor renderPassDescriptor];
+                            rp.colorAttachments[0].texture = T;
+                            rp.colorAttachments[0].loadAction = MTLLoadActionLoad;
+                            rp.colorAttachments[0].storeAction = MTLStoreActionStore;
+                            id<MTLRenderCommandEncoder> en = [cb renderCommandEncoderWithDescriptor:rp];
+                            [en setRenderPipelineState:ps[shader]];
+                            if (!shader) { [en setFragmentTexture:S atIndex:0]; [en setFragmentSamplerState:smp atIndex:0]; }
+                            for (int k = 0; k < layers; k++) [en drawPrimitives:MTLPrimitiveTypeTriangle vertexStart:0 vertexCount:3];
+                            [en endEncoding];
+                            [cb commit];
+                            [all addObject:cb];
+                            last = cb;
+                        }
+                        [last waitUntilCompleted];
+                        const double ms = (now() - t0) / n;
+                        if (ms < best) best = ms;
+                        NSMutableArray *g = [NSMutableArray new];
+                        for (id<MTLCommandBuffer> c in all) if (c.GPUEndTime > c.GPUStartTime) [g addObject:@((c.GPUEndTime - c.GPUStartTime) * 1e3)];
+                        [g sortUsingSelector:@selector(compare:)];
+                        if (g.count) gpu = [g[g.count / 2] doubleValue];
+                    }
+                    if (shader) printf("fill blend      -> %-9s  %6.2f ms/pass wall  %6.2f ms gpu (median)\n", nm[dst], best, gpu);
+                    else printf("sample %-9s-> %-9s  %6.2f ms/pass wall  %6.2f ms gpu (median)\n", nm[src], nm[dst], best, gpu);
+                }
+    }
+    return 0;
+}
