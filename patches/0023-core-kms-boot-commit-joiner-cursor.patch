+/*
+ * XeGfx (native-display docs/32-FRAME-RATE.md §32.10): per-stage execbuffer timing.  WindowServer's composites spend
+ * ~7 ms a frame in this ioctl (Linux: ~0.1 ms).  Each stage adds its time to a sum and a max; debug.xegfx_eb prints them
+ * (the maxes restart at every read).  xg_eb_outer is the whole remote ioctl as the shim sees it, drm dispatch included.
+ */
+enum { XG_EB_IOCTL, XG_EB_DO, XG_EB_EXT, XG_EB_SETUP, XG_EB_LOOKUP, XG_EB_PIN_ENGINE, XG_EB_VALIDATE, XG_EB_RELOC,
+	XG_EB_REQ_CREATE, XG_EB_SUBMIT, XG_EB_MOVE, XG_EB_CLFLUSH, XG_EB_REQ_ADD, XG_EB_RELEASE, XG_EB_OUTER,
+	XG_EB_LUT, XG_EB_LUT_MISS, XG_EB_UPTR, XG_EB_UPTR_SLOW, XG_EB_LOCK, XG_EB_PIN, XG_EB_RESERVE, XG_EB_N };
+static const char *const xg_eb_names[XG_EB_N] = { "ioctl", "do", "ext+fences", "setup", "lookup", "pin_engine",
+	"validate", "reloc+parse", "req_create", "submit", "move_to_gpu", "clflush", "req_add", "release", "outer",
+	"lut_lookup", "lut_miss", "userptr", "userptr>20us", "v:lock", "v:pin", "v:reserve" };
+static atomic64_t xg_eb_sum[XG_EB_N], xg_eb_cnt[XG_EB_N], xg_eb_max[XG_EB_N];
+static atomic64_t xg_eb_bufs, xg_eb_clflush_objs, xg_eb_clflush_bytes;
+static unsigned int xg_eb_bufs_max;
+
+static inline u64 xg_eb_t(void) { return ktime_get_ns(); }
+static void xg_eb_add(int s, u64 d)
+{
+	atomic64_add(d, &xg_eb_sum[s]);
+	atomic64_inc(&xg_eb_cnt[s]);
+	if ((s64)d > atomic64_read(&xg_eb_max[s]))
+		atomic64_set(&xg_eb_max[s], d);	/* racy by one sample at worst */
+}
+static void xg_eb_note(int s, u64 t0)
+{
+	xg_eb_add(s, ktime_get_ns() - t0);
+}
+void xg_eb_outer(unsigned long long ns);
+void
+xg_eb_outer(unsigned long long ns)
+{
+	xg_eb_add(XG_EB_OUTER, ns);
+}
+int xg_eb_stats_text(char *out, int max);
+int
+xg_eb_stats_text(char *out, int max)
+{
+	int n = 0, i;
+
+	n += snprintf(out + n, max - n, "calls %lld bufs %lld (max %u) clflush objs %lld bytes %lld\n",
+	    (long long)atomic64_read(&xg_eb_cnt[XG_EB_IOCTL]), (long long)atomic64_read(&xg_eb_bufs), xg_eb_bufs_max,
+	    (long long)atomic64_read(&xg_eb_clflush_objs), (long long)atomic64_read(&xg_eb_clflush_bytes));
+	for (i = 0; i < XG_EB_N && n < max - 80; i++) {
+		n += snprintf(out + n, max - n, "%-12s n %10lld sum_us %12lld max_us %8lld\n", xg_eb_names[i],
+		    (long long)atomic64_read(&xg_eb_cnt[i]), (long long)(atomic64_read(&xg_eb_sum[i]) / 1000),
+		    (long long)(atomic64_read(&xg_eb_max[i]) / 1000));
+		atomic64_set(&xg_eb_max[i], 0);
+	}
+	return (n);
+}
