+#!/bin/bash
+# After the E1-E3 reboot: sentinel, vblank source, flip counters around an fps-probe run.  Read-only.
+cd "$(dirname "$0")"
+echo "== E1 sentinel"; cat /var/log/xegfx-ws-nowait.log 2>/dev/null | tail -1; ls -la /private/tmp/xemtl-ws-nowait 2>&1
+echo "== E3 vblank"; /usr/bin/log show --last boot --predicate 'process == "kernel" AND (eventMessage CONTAINS "E3:" OR eventMessage CONTAINS "vblank source")' --style compact 2>/dev/null | cut -c 1-23,60-220 | tail -6
+ioreg -l -w0 -r -c XeGfxFramebuffer 2>/dev/null | grep -o '"XeGfxVblankCount" = [0-9]*' | head -1
+s() { sysctl -n debug.xegfxaccel_iop_xe_flips debug.xegfxaccel_iop_xe_early_signals debug.xegfxaccel_iop_xe_early_hazards \
+      debug.xegfxaccel_iop_xe_defer_dropped | tr '\n' ' '; }
+echo "== fps (flips early hazards dropped)"
+for sz in "1200 800" "2400 1500"; do
+  a=$(s); t0=$(date +%s); ./fps-probe 8 $sz | tail -1; t1=$(date +%s); b=$(s)
+  echo "  $sz before: $a after: $b ($((t1 - t0)) s)"
+done
+sysctl debug.xegfxaccel_iop_xe_idle_last_us debug.xegfxaccel_iop_xe_arm_last_us debug.xegfxaccel_iop_gap_last_us debug.xegfxaccel_iop_xe_defer_max_depth
+./display-modes-all | grep ^current
