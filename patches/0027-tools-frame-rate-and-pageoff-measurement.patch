+#!/usr/bin/python3
+# §32.10: i915 execbuffer per-stage time around an fps-probe run.  Reads debug.xegfx_eb before and after (sums are
+# cumulative, maxes restart at every read) and prints per-call averages for the run.  Read-only.
+import re, subprocess, sys, os
+D = os.path.dirname(os.path.abspath(__file__))
+def read():
+    t = subprocess.run(['/usr/sbin/sysctl', '-n', 'debug.xegfx_eb'], capture_output=True, text=True).stdout
+    head = re.search(r'calls (\d+) bufs (\d+) \(max (\d+)\) clflush objs (\d+) bytes (\d+)', t)
+    rows = {m[0]: (int(m[1]), int(m[2]), int(m[3])) for m in re.findall(r'^(\S+)\s+n\s+(\d+) sum_us\s+(\d+) max_us\s+(\d+)', t, re.M)}
+    return [int(x) for x in head.groups()], rows
+size = sys.argv[1:3] or ['1200', '800']
+h0, r0 = read()
+probe = subprocess.run([D+'/fps-probe', '8'] + size, capture_output=True, text=True).stdout
+h1, r1 = read()
+calls = h1[0] - h0[0]
+print(probe.strip().splitlines()[-1] if probe.strip() else 'fps-probe: no output')
+print('execbuffer calls %d (%.1f/s), bufs/call %.1f (max %d), clflush objs %d (%.1f MB)' % (calls, calls / 9.0,
+      (h1[1] - h0[1]) / max(calls, 1), h1[2], h1[3] - h0[3], (h1[4] - h0[4]) / 1e6))
+print('%-12s %8s %12s %10s %8s' % ('stage', 'n', 'sum_ms', 'avg_us', 'max_us'))
+for k in r1:
+    n = r1[k][0] - r0.get(k, (0, 0, 0))[0]; us = r1[k][1] - r0.get(k, (0, 0, 0))[1]
+    print('%-12s %8d %12.1f %10.1f %8d' % (k, n, us / 1000.0, us / max(n, 1), r1[k][2]))
