+    CK(vkGetQueryPoolResults(dev, qp, 0, 2 * passes, 16 * passes, ts, 8, VK_QUERY_RESULT_64_BIT | VK_QUERY_RESULT_WAIT_BIT));
+    for (int p = 0; p < passes; p++) ms[p] = (double)(ts[2 * p + 1] - ts[2 * p]) * tsPeriod / 1e6;
+    qsort(ms, passes, sizeof *ms, cmpd);
+    printf("  %-62s %7.2f ms gpu (median), min %.2f\n", what, ms[passes / 2], ms[0]);
+    free(ts); free(ms);
+    vkDestroyQueryPool(dev, qp, NULL); vkDestroyFramebuffer(dev, fb, NULL); vkDestroyImageView(dev, view, NULL);
+    vkDestroyImage(dev, img, NULL); vkFreeMemory(dev, mem, NULL); free(host);
+}
