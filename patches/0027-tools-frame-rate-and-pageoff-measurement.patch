+#!/bin/bash
+# display-capture.sh [label] -- read-only snapshot of the display stack, as the reference for the XeGfx KMS work.
+# Meant first for a Discrete (dGPU-direct) boot, where NullMoth's NVRMFB drives the built-in panel, and then for the
+# XeGfx boot to compare against.  Writes data/display-<stamp>-<label>/; needs no root (a few items are skipped
+# without it).  Nothing here writes NVRAM, a sysctl, the registry or a display register.
+set -uo pipefail
+HERE=$(cd "$(dirname "$0")" && pwd)
+ROOT=$(dirname "$HERE")
+LABEL=${1:-$( (ioreg -r -c NVRMNVDAFramebuffer -d1 | grep -q NVRMNVDAFramebuffer) && echo discrete || echo igpu)}
+OUT="$ROOT/data/display-$(date +%Y%m%d-%H%M%S)-$LABEL"
+mkdir -p "$OUT"
+note() { printf '%s\n' "$*" | tee -a "$OUT/capture.log"; }
+cap() { local f=$1; shift; "$@" > "$OUT/$f" 2>&1 || note "  ($f exited $?)"; }
+
+note "== display-capture $LABEL -> $OUT"
+{
+    date; sw_vers; uname -a; uptime
+    sysctl kern.boottime kern.bootsessionuuid machdep.cpu.brand_string
+    echo; nvram boot-args
+    echo; nvram -p | grep -E '^(nullmoth|xegfx|xeintelfb|nv)' || true
+    echo; csrutil status 2>&1 | head -3
+} > "$OUT/meta.txt" 2>&1
+
+# kexts and the GPUs
+cap kexts.txt kmutil showloaded --list-only --variant-suffix release
+grep -E -i 'nullmoth|watchthelight|xegfx|NVRM|NVAccel|AppleGraphics|IOGraphics|AGDC|AppleBacklight' "$OUT/kexts.txt" > "$OUT/kexts-display.txt" || true
+cap gpus.txt ioreg -r -k class-code -l -w0 -d1 -x
+cap system-profiler.txt system_profiler SPDisplaysDataType
+cap system-profiler.xml system_profiler -xml SPDisplaysDataType
+
+# the framebuffer, the display and AGDC: full property dumps
+for c in IOFramebuffer IODisplayConnect AppleDisplay IODisplay AppleGraphicsDeviceControl AppleBacklightDisplay \
+         IOAccelerator IOPresentment NVRMNVDAFramebuffer NVRMDisplay XeGfxFramebuffer XeGfxDisplayNub; do
+    ioreg -r -c "$c" -l -w0 > "$OUT/ioreg-$c.txt" 2>&1
+    [ -s "$OUT/ioreg-$c.txt" ] || rm -f "$OUT/ioreg-$c.txt"
+done
+cap ioreg-full.txt ioreg -l -w0
+# the framebuffer properties that matter for modes, scaling and timing, one per line
+grep -E '"(IOFBScalerInfo|IOFBDetailedTimings|IOFBTimingRange|IOFBMemorySize|IOFBCurrentPixelCount|IOFBCurrentPixelClock|IOFBTransform|IOFBConfig|IOFBNeedsRefresh|IOFBProbeOptions|IOFBGammaWidth|IOFBGammaCount|IOFBUIScale|IOFB0Hz|IOFBDisplayModeCount|IOFBMirrorDisplayModeSafe|IOFBCLUTDefer|IOFBDisplayPortTrainingAttribute|IOFBWaitCursorFrames|IODisplayEDID|DisplayVendorID|DisplayProductID|IODisplayPrefsKey|IODisplayParameters|IOFBDependentID|IOFBDependentIndex|NVRM[A-Za-z]*|XeGfx[A-Za-z]*|AAPL,[A-Za-z-]*|backlight-control|IOAccelIndex|IOAccelRevision)"' \
+    "$OUT/ioreg-full.txt" | sed 's/^[ |+-]*//' > "$OUT/fb-key-props.txt" || true
+
+# every mode CoreGraphics offers (HiDPI duplicates included) and the current one
+if [ -x "$HERE/display-modes" ] || clang -fobjc-arc -framework CoreGraphics -framework IOKit -framework Foundation \
+        "$HERE/display-modes.m" -o "$HERE/display-modes" 2> "$OUT/display-modes-build.txt"; then
+    cap display-modes.tsv "$HERE/display-modes"
+    grep -E '^(display|current)' "$OUT/display-modes.tsv" | tee -a "$OUT/capture.log"
+    awk -F'\t' '$1=="mode"{print $3"@"int($4+0.5)}' "$OUT/display-modes.tsv" | sort | uniq -c | sort -rn > "$OUT/raster-refresh-summary.txt"
+fi
+
+# the sysctls each stack publishes
+sysctl -a 2>/dev/null | grep -E '^debug\.(nvrm|nv|xegfx|nmx|agdc)' > "$OUT/sysctl-debug.txt" || true
+
+# kernel log of this boot: the display chain (NVRM/NVKMS, NVRMFB, AGDC, accel, XeGfx) and IOGraphics
+P='process == "kernel" AND (sender BEGINSWITH "NVRM" OR sender BEGINSWITH "NVAccel" OR sender BEGINSWITH "NVDA" OR sender BEGINSWITH "XeGfx" OR sender BEGINSWITH "IOGraphics" OR sender == "AppleDisplay" OR sender BEGINSWITH "AppleBacklight" OR sender BEGINSWITH "AppleGraphicsDevicePolicy" OR sender BEGINSWITH "AppleGraphicsControl")'
+/usr/bin/log show --last boot --predicate "$P" --style compact > "$OUT/kernel-display.log" 2>&1
+grep -E 'NVRM-fb:|NVKMS|nvkms' "$OUT/kernel-display.log" > "$OUT/nvrmfb.log" || true
+# the lines that answer the open XeGfx questions: link rate/lanes, DSC, bpc, modes, scaler, validate/set calls
+grep -i -E 'dsc|link|lane|hbr|rate|bpc|bpp|depth|scal|hidpi|validate|setDisplayMode|setDetailedTimings|mode 0x|timing|edid|ddc|backlight|agdc|vblank|refresh|Hz' \
+    "$OUT/nvrmfb.log" > "$OUT/nvrmfb-keylines.log" || true
+# WindowServer/CoreDisplay this boot (mode decisions, IOPresentment)
+/usr/bin/log show --last boot --predicate 'process == "WindowServer" AND (subsystem BEGINSWITH "com.apple.CoreDisplay" OR subsystem BEGINSWITH "com.apple.SkyLight" OR category CONTAINS[c] "display")' \
+    --style compact > "$OUT/windowserver-display.log" 2>&1
+
+# display preferences macOS chose (scaled mode, refresh)
+cap display-prefs.txt defaults read /Library/Preferences/com.apple.windowserver.displays
+ls -la /Library/Displays/Contents/Resources/Overrides/DisplayVendorID-9e5 > "$OUT/overrides-9e5.txt" 2>&1 || true
+
+note "   kernel-display.log $(wc -l < "$OUT/kernel-display.log") lines, nvrmfb-keylines $(wc -l < "$OUT/nvrmfb-keylines.log" 2>/dev/null || echo 0)"
+note "== done: $OUT"
