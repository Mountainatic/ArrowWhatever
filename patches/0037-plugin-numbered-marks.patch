+// §37.29: a composite whose kernel mark is released late (the flip waits for it): commit -> scheduled -> GPU done ->
+// release, in ms, logged so the 100 ms flip timeouts can be placed.  Rate limited.
+static _Atomic unsigned nvmtl_ws_late_n;
+static void nvmtl_ws_late_note(XeMTLSurfaceHolds *h, uint32_t sid, BOOL last) {
+    if (!h->t0) return;
+    const uint64_t now = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+    if (now - h->t0 < 30000000ull) return;
+    const unsigned k = atomic_fetch_add(&nvmtl_ws_late_n, 1);
+    if (k >= 200 && (k & 31)) return;
+    nvlog("ws late: surface %u released %.1f ms after commit (scheduled +%.1f, GPU done +%.1f, %s holder; parts %u waits %u) [%u]",
+          (unsigned)sid, (double)(now - h->t0) / 1e6, h->tSched ? (double)(h->tSched - h->t0) / 1e6 : -1.0,
+          h->tDone ? (double)(h->tDone - h->t0) / 1e6 : -1.0, last ? "last" : "not last", h->nparts, h->nwaits, k + 1);
+}
