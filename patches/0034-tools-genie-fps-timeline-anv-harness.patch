+#!/usr/bin/env python3
+"""Rebuild one target of a meson-generated build.ninja without ninja: walks the dependency graph, recompiles objects
+whose source or depfile headers are newer, re-archives and relinks. usage: minininja.py <builddir> <target> [-n]"""
+import os, re, shlex, subprocess, sys
+
+def parse(path):
+    rules, builds, glob = {}, {}, {}
+    lines = open(path).read().replace('$\n', '').splitlines()
+    i = 0
+    while i < len(lines):
+        ln = lines[i]; i += 1
+        if not ln or ln.startswith('#'): continue
+        if ln.startswith('rule '):
+            name = ln[5:].strip(); vars_ = {}
+            while i < len(lines) and lines[i].startswith(' '):
+                k, _, v = lines[i].strip().partition(' = '); vars_[k] = v; i += 1
+            rules[name] = vars_
+        elif ln.startswith('build '):
+            outs, _, rest = ln[6:].partition(': ')
+            parts = rest.replace('$ ', '\0').split(' ')
+            parts = [p.replace('\0', ' ').replace('$:', ':') for p in parts if p]
+            rule = parts[0]; exp, imp, order = [], [], []; cur = exp
+            for p in parts[1:]:
+                if p == '|': cur = imp; continue
+                if p == '||': cur = order; continue
+                cur.append(p)
+            vars_ = {}
+            while i < len(lines) and lines[i].startswith(' '):
+                k, _, v = lines[i].strip().partition(' = '); vars_[k] = v; i += 1
+            o = [x.replace('$:', ':') for x in outs.split(' ') if x and x != '|']
+            b = dict(rule=rule, outs=o, exp=exp, imp=imp, order=order, vars=vars_)
+            for x in o: builds[x] = b
+        elif ' = ' in ln and not ln.startswith(' '):
+            k, _, v = ln.partition(' = '); glob[k.strip()] = v
+    return rules, builds, glob
+
+def expand(s, env):
+    return re.sub(r'\$\{?(\w+)\}?', lambda m: env.get(m.group(1), ''), s)
+
+def mtime(p):
+    try: return os.stat(p).st_mtime
+    except OSError: return None
+
+def depfile_deps(p):
+    try: t = open(p).read().replace('\\\n', ' ')
+    except OSError: return None
+    _, _, deps = t.partition(':')
+    return [d.replace('\\ ', ' ') for d in re.split(r'(?<!\\)\s+', deps) if d]
+
+def main():
+    bdir, target = sys.argv[1], sys.argv[2]; dry = '-n' in sys.argv
+    os.chdir(bdir)
+    rules, builds, glob = parse('build.ninja')
+    done = {}
+    def build(t):
+        if t in done: return done[t]
+        b = builds.get(t)
+        if b is None or b['rule'] == 'phony':
+            if b: [build(x) for x in b['exp'] + b['imp']]
+            done[t] = mtime(t) or 0; return done[t]
+        newest = 0
+        for x in b['exp'] + b['imp']: newest = max(newest, build(x) or 0)
+        for x in b['order']: build(x)
+        out = b['outs'][0]; om = mtime(out)
+        dirty = om is None or newest > om
+        env = dict(glob); env.update(rules[b['rule']]); env.update(b['vars'])
+        env['in'] = ' '.join(shlex.quote(x) for x in b['exp']); env['out'] = ' '.join(shlex.quote(x) for x in b['outs'])
+        if not dirty and 'DEPFILE' in b['vars']:
+            deps = depfile_deps(expand(b['vars']['DEPFILE'], env))
+            if deps is not None and any((mtime(d) or 0) > om for d in deps): dirty = True
+        if dirty and b['rule'] not in ('SHSYM', 'CUSTOM_COMMAND', 'CUSTOM_COMMAND_DEP', 'REGENERATE_BUILD'):
+            cmd = expand(expand(rules[b['rule']]['command'], env), env)
+            print(('[dry] ' if dry else '') + b['rule'] + ' ' + out, flush=True)
+            if not dry:
+                r = subprocess.run(cmd, shell=True)
+                if r.returncode: print('FAILED: ' + cmd[:2000]); sys.exit(1)
+        done[t] = mtime(out) or newest; return done[t]
+    build(target)
+
+if __name__ == '__main__':
+    main()
