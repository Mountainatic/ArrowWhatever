+ * §37.17 (native-display docs/37-RENDER-COMPRESSION.md): import an IOSurface by its kernel memory, as Apple's
+ * IOAcceleratorFamily2 (IOAccelResource2::newResourceWithIOSurface) and NullMoth's surface imports by ID do, instead of
+ * pinning the user mapping of it (a userptr object: ~2 us a page on its first execbuffer, half of it the shim's
+ * per-page vm_page records, a third building the page list).  ANV cannot import a GEM handle through our fds (it sizes
+ * an imported dma-buf with lseek, and the libdrm stand-in's fds are pipes), so the plugin keeps its host-pointer
+ * import and announces it instead: the accelerator looks the surface up in the caller's task and hands its
+ * IOMemoryDescriptor over ("xgSurfTicket": retained, a one-shot ticket bound to that task); the plugin names the
+ * ticket with the pointer and size it is about to import (SURF_EXPECT, on ANV's own DRM file); the matching
+ * DRM_IOCTL_I915_GEM_USERPTR on that file then gets an object made of the surface's memory instead of a userptr.
+ * Its pages are the descriptor's physical ranges, wired once by prepare(); like a stolen object it has no struct
+ * pages, only DMA addresses (nothing maps or clflushes it: no CPU write domain, the coherent PAT a userptr gets), and
+ * the descriptor is completed and released with it.  An announcement nobody matched goes after 2 s or with its file.
+ */
+struct xg_drm_surf_expect {
+	u32	ticket;		/* in: from the accelerator */
+	u32	pad;
+	u64	user_ptr;	/* in: the pointer and size of the userptr import that follows */
+	u64	user_size;
+};
+#define XG_DRM_IOCTL_SURF_EXPECT	_IOW('N', 0x4A, struct xg_drm_surf_expect)
+
+struct xg_ticket {
+	struct list_head	link;
+	u32			id;
+	void			*task;
+	void			*md;
+	u64			size;	/* the descriptor's, page-rounded */
+	u64			born;	/* ns */
+	void			*key;	/* once announced: the file, the pointer and the size of the import */
+	u64			user_ptr, user_size;
+};
+struct xg_surfobj {
+	struct list_head		link;
+	struct drm_i915_gem_object	*obj;
+	void				*md;
+	u64				*pa, *len;
+	unsigned int			n;
+};
+static LIST_HEAD(xg_tickets);		/* handed over, not announced yet */
+static LIST_HEAD(xg_expects);		/* announced, waiting for their userptr */
+static LIST_HEAD(xg_surfobjs);
+static DEFINE_MUTEX(xg_surf_lock);
+static u32 xg_ticket_next;
+/* debug.xegfx_uhold (xg_kext.cpp) */
+u64 xg_surf_imports, xg_surf_pages, xg_surf_ns, xg_surf_ranges, xg_surf_frees, xg_surf_live, xg_surf_fail;
+
+/* with xg_surf_lock held: tickets and announcements older than 2 s move to *stale */
+static void
+xg_surf_expire_locked(u64 now, struct list_head *stale)
+{
+	struct xg_ticket *e, *et;
+
+	list_for_each_entry_safe(e, et, &xg_tickets, link)
+		if (now - e->born > 2000000000ull)
+			list_move(&e->link, stale);
+	list_for_each_entry_safe(e, et, &xg_expects, link)
+		if (now - e->born > 2000000000ull)
+			list_move(&e->link, stale);
+}
+
+static void
+xg_surf_drop_list(struct list_head *l)
+{
+	struct xg_ticket *e, *et;
+
+	list_for_each_entry_safe(e, et, l, link) {
+		list_del(&e->link);
+		xg_md_drop(e->md, 0);
+		kfree(e);
+	}
+}
