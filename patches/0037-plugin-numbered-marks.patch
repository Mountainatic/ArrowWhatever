 static _Atomic int g_t4_on;
 static _Atomic uint32_t g_t4_scan[8];
 static _Atomic unsigned g_t4_scan_next;
+static void nvmtl_t4_reply(uint32_t surfaceID, uint64_t out)
+{
+    if (atomic_exchange(&g_t4_sel, 1) != 1) nvlog("Tile4: the accelerator takes layout marks (selector 2), scanout Tile4 %s", (out & 2) ? "on" : "off");
+    atomic_store(&g_t4_on, (out & 2) ? 1 : 0);
+    { extern _Atomic int g_ccs_on; atomic_store(&g_ccs_on, (out & 4) ? 1 : 0); }   // <wtl> §37.14
+    if ((out & 1) && surfaceID) {
+        int known = 0;
+        for (unsigned i = 0; i < 8; i++) if (atomic_load(&g_t4_scan[i]) == surfaceID) { known = 1; break; }
+        if (!known) {
+            atomic_store(&g_t4_scan[atomic_fetch_add(&g_t4_scan_next, 1) & 7], surfaceID);
+            nvlog("Tile4: surface %u is a scanout surface", surfaceID);
+        }
+    }
+}
+static _Atomic int g_seq_sel;   // <wtl> §37.30: 0 untried, 1 selector 13 answers, -1 it does not
+int nvmtl_vk_surface_gpu_mark3(uint32_t surfaceID, int op, int tile4, uint32_t seq, uint32_t *seq_out)
+{
+    if (seq_out) *seq_out = 0;
+    if ((pnvk_surface_dirty && g_dev) || atomic_load(&g_seq_sel) < 0 || !nvmtl_mark_conn()) return 0;
+    const uint64_t in[4] = { surfaceID, (uint64_t)op, tile4 ? 1u : 0u, seq };
+    uint64_t out[2] = { 0, 0 }; uint32_t outn = 2;
+    const kern_return_t kr = IOConnectCallScalarMethod(g_mark_conn, 13, in, 4, out, &outn);
+    if (kr == KERN_SUCCESS) {
+        if (atomic_exchange(&g_seq_sel, 1) != 1) nvlog("marks: one numbered mark per command buffer (selector 13); a flip waits only for the work before it");
+        nvmtl_t4_reply(surfaceID, out[0]);
+        if (seq_out) *seq_out = (uint32_t)out[1];
+        return 1;
+    }
+    int untried = 0;
+    if (atomic_compare_exchange_strong(&g_seq_sel, &untried, -1)) nvlog("marks: no selector 13 (0x%x) -- one mark per surface", kr);
+    return 0;
+}
