+int main(int argc, char **argv)
+{
+    const int passes = argc > 1 ? atoi(argv[1]) : 30, layers = argc > 2 ? atoi(argv[2]) : 4;
+    VkApplicationInfo app = { VK_STRUCTURE_TYPE_APPLICATION_INFO, NULL, "rt-bench", 1, NULL, 0, VK_API_VERSION_1_3 };
+    const char *iext[] = { "VK_KHR_portability_enumeration" };
+    VkInstanceCreateInfo ici = { VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO, NULL, VK_INSTANCE_CREATE_ENUMERATE_PORTABILITY_BIT_KHR, &app, 0, NULL, 1, iext };
+    VkInstance inst;
+    if (vkCreateInstance(&ici, NULL, &inst) != VK_SUCCESS) { ici.flags = 0; ici.enabledExtensionCount = 0; CK(vkCreateInstance(&ici, NULL, &inst)); }
+    uint32_t n = 8; VkPhysicalDevice pds[8]; CK(vkEnumeratePhysicalDevices(inst, &n, pds));
+    pd = NULL;
+    for (uint32_t i = 0; i < n && !pd; i++) { VkPhysicalDeviceProperties p; vkGetPhysicalDeviceProperties(pds[i], &p); if (p.vendorID == 0x8086) pd = pds[i]; }
+    if (!pd) { fprintf(stderr, "no Intel device\n"); return 1; }
