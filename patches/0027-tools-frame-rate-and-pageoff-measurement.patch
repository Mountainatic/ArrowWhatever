+# lockcross.py <ktrace.csv> <ws-drawn.txt>: who CPU-locked each surface WindowServer draws (ktrace -f S0x8521 --csv;
+# ws-drawn.txt = the id/size/marks columns of `sysctl -n debug.nvaccel_iop_xe_locks`).  0x85210010 is
+# IOSurface::lockSurface's tracepoint: arg2 surface ID, arg3 lock options (bit 0 read-only), arg4 seed.
+import csv, collections, sys
+drawn = {int(l.split()[0]): (l.split()[1], int(l.split()[2])) for l in open(sys.argv[2])}
+by = collections.defaultdict(collections.Counter)
+for r in csv.DictReader(open(sys.argv[1])):
+    if int(r['debugid']) & ~3 != 0x85210010: continue
+    by[int(r['arg2'])][(r['execname'], 'ro' if int(r['arg3']) & 1 else 'w')] += 1
+for sid, (size, marks) in sorted(drawn.items(), key=lambda x: -x[1][1]):
+    print('%5d %-10s marks %7d  locks %s' % (sid, size, marks, dict(by.get(sid, {})) or '-'))
