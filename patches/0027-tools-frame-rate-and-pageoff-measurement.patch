+        VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT, VK_SHARING_MODE_EXCLUSIVE, 0, NULL, VK_IMAGE_LAYOUT_UNDEFINED };
+    VkImage img; { VkResult cr = vkCreateImage(dev, &ii, NULL, &img); if (cr != VK_SUCCESS) { printf("  kind %d: image refused (%d)\n", kind, cr); return; } }
