+import sys, bisect
+base, pref = sys.argv[1], sys.argv[2]
+addrs = [int(l.split()[0], 16) for l in open(base + '.tsyms')]
+names = [l.rstrip('\n') for l in open(base + '.tsyms.d')]
+hits = [i for i, n in enumerate(names) if n.startswith(pref)]
+if not hits: sys.exit('not found: ' + pref)
+i = hits[int(sys.argv[3]) if len(sys.argv) > 3 else 0]
+s, e = addrs[i], addrs[i + 1] if i + 1 < len(addrs) else 1 << 64
+print('## %s  0x%x..0x%x (%d B)%s' % (names[i], s, e, e - s, '  [%d matches]' % len(hits) if len(hits) > 1 else ''))
+on = False
+for l in open(base + '.dis'):
+    t = l.split('\t', 1)[0].strip()
+    try: a = int(t, 16)
+    except ValueError: 
+        if on: print(l, end='')
+        continue
+    if a >= e: break
+    on = a >= s
+    if on: print(l, end='')
