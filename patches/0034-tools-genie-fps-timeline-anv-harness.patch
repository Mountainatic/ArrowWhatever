+#!/bin/bash
+# Re-arm the claim boot after a bootguard fallback: restore the gates the guard recorded as gates_before.
+set -euo pipefail
+B=/Library/XeGfxTrial/rearm-$(date +%Y%m%d-%H%M%S)
+mkdir -p "$B"
+/usr/sbin/nvram -x -p > "$B/nvram-before.plist"
+touch /Library/GPUBundles/.xemtl-no-ssbo-push
+for kv in expose=%01%00%00%00 starts=%00%00%00%00 fail=%00%00%00%00 bootarm=%00%00%00%00 phase=%02%00%00%00 trial=%01%00%00%00; do
+  /usr/sbin/nvram "xegfx-disp-$kv"
+done
+for g in phase trial starts fail expose bootarm; do /usr/sbin/nvram "xegfx-disp-$g"; done | tee "$B/gates-after.txt"
+ls -la /Library/GPUBundles/.xemtl-no-ssbo-push
+echo "backup=$B"
