+// display-modes-all: every mode SkyLight holds for each online display, including the ones the public
+// CGDisplayCopyAllDisplayModes hides, with the pixel density (2.0 = HiDPI).  Read-only; same private calls as displayplacer.
+// Build: clang -fobjc-arc -framework CoreGraphics -framework Foundation display-modes-all.m -o display-modes-all
+#import <CoreGraphics/CoreGraphics.h>
+#import <Foundation/Foundation.h>
+
+typedef union {
+    uint8_t bytes[0xD4];
+    struct {
+        uint32_t mode;
+        uint32_t flags;
+        uint32_t width;
+        uint32_t height;
+        uint32_t depth;
+        uint32_t dc2[42];
+        uint16_t dc3;
+        uint16_t freq;
+        uint32_t dc4[4];
+        float density;
+    } d;
+} XGModeD4;
+
+extern void CGSGetCurrentDisplayMode(CGDirectDisplayID display, int *modeNum);
+extern void CGSGetNumberOfDisplayModes(CGDirectDisplayID display, int *nModes);
+extern void CGSGetDisplayModeDescriptionOfLength(CGDirectDisplayID display, int idx, XGModeD4 *mode, int length);
+
+int main(void)
+{
+    CGDirectDisplayID ids[16];
+    uint32_t n = 0;
+    if (CGGetOnlineDisplayList(16, ids, &n) != kCGErrorSuccess) return 1;
+    for (uint32_t i = 0; i < n; i++) {
+        int count = 0, cur = -1;
+        CGSGetNumberOfDisplayModes(ids[i], &count);
+        CGSGetCurrentDisplayMode(ids[i], &cur);
+        printf("display\t0x%x\tmodes=%d\tcurrent=%d\n", ids[i], count, cur);
+        for (int k = 0; k < count; k++) {
+            XGModeD4 m;
+            memset(&m, 0, sizeof m);
+            CGSGetDisplayModeDescriptionOfLength(ids[i], k, &m, 0xD4);
+            printf("%s\t%d\tpoints=%ux%u\tpixels=%.0fx%.0f\tdensity=%.1f\t%uHz\tdepth=%u\tflags=0x%08x\tid=0x%x\n",
+                   k == cur ? "current" : "mode", k, m.d.width, m.d.height, m.d.width * m.d.density,
+                   m.d.height * m.d.density, m.d.density, m.d.freq, m.d.depth, m.d.flags, m.d.mode);
+        }
+    }
+    return 0;
+}
