+# shader-stats.py: compile every lowered fragment shader in low/ with ANV's pushes off and on (ssbo-push-test real)
+# and print the ones whose statistics change: (SIMD, SENDs, cycles, spills, fills) off, then on.
+# XEGFX_ICD names the ICD json (default: the installed /Library/GPUBundles/xemtl/intel_icd.json).
+import subprocess, re, os, sys, glob, concurrent.futures as cf
+S = os.path.dirname(os.path.abspath(__file__))
+def st(spv, push):
+    e = dict(os.environ, VK_ICD_FILENAMES=os.environ.get('XEGFX_ICD', '/Library/GPUBundles/xemtl/intel_icd.json'), MESA_SHADER_CACHE_DISABLE='true', XEMTL_SSBO_PUSH=push, SPDIR=S)
+    o = subprocess.run([os.path.join(S, 'ssbo-push-test'), 'real', spv], capture_output=True, text=True, env=e).stdout
+    m = re.search(r'SIMD(\d+) fragment: SENDs=(\d+) Cycles=(\d+) Spills=(\d+) Fills=(\d+)', o)
+    return m.groups() if m else None
+spvs = sorted(glob.glob(os.path.join(S, 'low', '*.spv')))
+def one(p): return p, st(p, '0'), st(p, '1')
+with cf.ThreadPoolExecutor(6) as ex:
+    for p, a, b in ex.map(one, spvs):
+        if a != b: print(os.path.basename(p), a, b, flush=True)
