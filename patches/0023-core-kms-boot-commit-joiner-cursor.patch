+int xg_rq_stats_text(char *out, int max);
+int
+xg_rq_stats_text(char *out, int max)
+{
+	static const char *const cls[2] = { "other", "WindowServer" };
+	int n = 0;
+
+	n += snprintf(out + n, max - n, "untracked %lld no-ready %lld (dep = queued->ready, run = ready->done, us)\n",
+	    (long long)atomic64_read(&xg_rq_untracked), (long long)atomic64_read(&xg_rq_noready));
+	for (int c = 1; c >= 0 && n < max; c--) {
+		const s64 k = atomic64_read(&xg_rq_n[c]) ? atomic64_read(&xg_rq_n[c]) : 1;
+
+		n += snprintf(out + n, max - n, "%-12s n %lld dep avg %lld max %lld | run avg %lld max %lld | total avg %lld max %lld | >50ms %lld >100ms %lld\n",
+		    cls[c], (long long)atomic64_read(&xg_rq_n[c]),
+		    (long long)(atomic64_read(&xg_rq_sum[c][XG_RQ_DEP]) / k / 1000), (long long)(atomic64_read(&xg_rq_max[c][XG_RQ_DEP]) / 1000),
+		    (long long)(atomic64_read(&xg_rq_sum[c][XG_RQ_RUN]) / k / 1000), (long long)(atomic64_read(&xg_rq_max[c][XG_RQ_RUN]) / 1000),
+		    (long long)(atomic64_read(&xg_rq_sum[c][XG_RQ_TOTAL]) / k / 1000), (long long)(atomic64_read(&xg_rq_max[c][XG_RQ_TOTAL]) / 1000),
+		    (long long)atomic64_read(&xg_rq_over50[c]), (long long)atomic64_read(&xg_rq_over100[c]));
+		for (int s = 0; s < XG_RQ_STAGES; s++)
+			atomic64_set(&xg_rq_max[c][s], 0);
+	}
+	n += snprintf(out + n, max - n, "WindowServer requests over 50 ms since the last read (t_ms dep_us run_us others_done own_done prio):\n");
+	{
+		const unsigned int last = (unsigned int)atomic_xchg(&xg_rq_slow_n, 0);
+
+		for (unsigned int i = 0; i < last && i < XG_RQ_SLOW && n < max; i++) {
+			const struct xg_rq_slow *e = &xg_rq_slow[(last - i) % XG_RQ_SLOW];
+
+			n += snprintf(out + n, max - n, "  %llu %llu %llu %lld %lld %d\n", (unsigned long long)e->t_ms,
+			    (unsigned long long)e->dep_us, (unsigned long long)e->run_us, (long long)e->others, (long long)e->own, e->prio);
+		}
+	}
+	return (n < max ? n : max - 1);
+}
