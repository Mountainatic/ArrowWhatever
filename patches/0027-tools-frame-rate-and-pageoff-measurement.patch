+// display-set-mode: switch the main display to a SkyLight mode, including the "not preset" HiDPI ones the public API
+// hides (same private calls as displayplacer).  Usage:
+//   display-set-mode <points-w> <points-h> <density> <hz>   pick by size/density/refresh, print the old and new index
+//   display-set-mode index <n>                              switch to mode index n (e.g. back to the old one)
+// Build: clang -fobjc-arc -framework CoreGraphics -framework Foundation -F/System/Library/PrivateFrameworks
+//        -framework SkyLight display-set-mode.m -o display-set-mode
+#import <CoreGraphics/CoreGraphics.h>
+#import <Foundation/Foundation.h>
+#include <stdlib.h>
+#include <string.h>
+
+typedef union {
+    uint8_t bytes[0xD4];
+    struct {
+        uint32_t mode;
+        uint32_t flags;
+        uint32_t width;
+        uint32_t height;
+        uint32_t depth;
+        uint32_t dc2[42];
+        uint16_t dc3;
+        uint16_t freq;
+        uint32_t dc4[4];
+        float density;
+    } d;
+} XGModeD4;
+
+extern void CGSGetCurrentDisplayMode(CGDirectDisplayID display, int *modeNum);
+extern void CGSGetNumberOfDisplayModes(CGDirectDisplayID display, int *nModes);
+extern void CGSGetDisplayModeDescriptionOfLength(CGDirectDisplayID display, int idx, XGModeD4 *mode, int length);
+extern CGError CGSConfigureDisplayMode(CGDisplayConfigRef config, CGDirectDisplayID display, int modeNum);
+
+static int switchTo(CGDirectDisplayID d, int idx)
+{
+    CGDisplayConfigRef cfg;
+    if (CGBeginDisplayConfiguration(&cfg) != kCGErrorSuccess) return 1;
+    CGError e = CGSConfigureDisplayMode(cfg, d, idx);
+    if (e != kCGErrorSuccess) { CGCancelDisplayConfiguration(cfg); fprintf(stderr, "configure %d\n", e); return 1; }
+    e = CGCompleteDisplayConfiguration(cfg, kCGConfigurePermanently);
+    if (e != kCGErrorSuccess) { fprintf(stderr, "complete %d\n", e); return 1; }
+    return 0;
+}
+
+int main(int argc, char **argv)
+{
+    CGDirectDisplayID d = CGMainDisplayID();
+    int count = 0, cur = -1, want = -1;
+    CGSGetNumberOfDisplayModes(d, &count);
+    CGSGetCurrentDisplayMode(d, &cur);
+    if (argc == 3 && strcmp(argv[1], "index") == 0) {
+        want = atoi(argv[2]);
+    } else if (argc == 5) {
+        uint32_t w = (uint32_t)atoi(argv[1]), h = (uint32_t)atoi(argv[2]), hz = (uint32_t)atoi(argv[4]);
+        float dens = (float)atof(argv[3]);
+        for (int k = 0; k < count; k++) {
+            XGModeD4 m;
+            memset(&m, 0, sizeof m);
+            CGSGetDisplayModeDescriptionOfLength(d, k, &m, 0xD4);
+            if (m.d.width == w && m.d.height == h && m.d.freq == hz && m.d.density > dens - 0.05f && m.d.density < dens + 0.05f) {
+                want = k;
+                break;
+            }
+        }
+    } else {
+        fprintf(stderr, "usage: %s <w> <h> <density> <hz> | index <n>\n", argv[0]);
+        return 2;
+    }
+    if (want < 0 || want >= count) { fprintf(stderr, "no such mode (current %d of %d)\n", cur, count); return 1; }
+    printf("old=%d new=%d\n", cur, want);
+    fflush(stdout);
+    if (want == cur) return 0;
+    return switchTo(d, want);
+}
