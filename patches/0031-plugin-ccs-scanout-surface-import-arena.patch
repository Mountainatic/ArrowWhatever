+static pthread_mutex_t g_arena_mu = PTHREAD_MUTEX_INITIALIZER;
+static uint64_t g_arena_allocs, g_arena_frees, g_arena_blocks_made, g_arena_blocks_freed, g_arena_misses;
+static int nvmtl_arena_on(void)
+{
+    static int on = -1;
+    if (on < 0) {
+        const char *e = getenv("XEMTL_NO_ARENA");
+        on = !(e && e[0] == '1') && access("/Library/GPUBundles/.xemtl-no-arena", F_OK) != 0;
