+// <wtl> §37.14 phase 2: a scanout surface drawn over its pages becomes a private compressed image the display scans
+// itself (nvmtl_vk_image_create_ccs, registered with the accelerator).  Made from the pages on the GPU and swapped in as
+// nvmtl_po_promote does; from then on it is a page-off copy (CPU locks bring the pages up to date, linear), so the pages'
+// layout is linear again for the accelerator's fallback (a frame it cannot scan compressed is paged off and scanned
+// linear).  Once per surface.
+static void nvmtl_ccs_promote(XeMTLTexture *r)
+{
+    static _Atomic int fails;
+    const uint32_t sid = IOSurfaceGetID(r->_surf);
+    r->_ccsTried = YES;
+    { extern void nvmtl_roots_dump(uint32_t, const char *); nvmtl_roots_dump(sid, "ccs promote"); }   // §37.14 diagnosis
+    if (atomic_load(&fails) >= 3) return;
+    XeMTLTexture *to = [XeMTLTexture new]; to->_tile4 = NO; to->_ccsWant = YES;
+    if (nvmtl_surface_image_create(to, r->_surf, r->_plane, r->_i.w, r->_i.h, r->_i.fmt, r->_i.bpp, 0, r->_i.storage ? 1 : 0) || !to->_i.ccs_token) {
+        atomic_fetch_add(&fails, 1); nvlog("ccs: surface %u: no compressed image -- stays over its pages", sid); return; }
+    to->_ccsWant = NO;
+    to->_q = r->_q; to->_surf = r->_surf; CFRetain(to->_surf); to->_surfOwned = YES; to->_plane = r->_plane;
+    to->_fmt = r->_fmt; to->_usage = r->_usage; to->_stex = to->_i.storage != 0;
+    if (!nvmtl_tile4_relayout([r device], r, to)) { atomic_fetch_add(&fails, 1); nvlog("ccs: surface %u: copy from its pages failed -- stays over them", sid); return; }
+    @synchronized (nvmtl_surface_sync(r)) {
+        @synchronized (r) {
+            const nvk_image old = r->_i; r->_i = to->_i; to->_i = old;
+            r->_hostImg = NO; r->_po = YES; r->_ccs = YES; r->_poDrawn = NO; r->_tile4 = NO; to->_tile4 = YES; r->_imgGen++;
+            r->_surfSeed = IOSurfaceGetSeed(r->_surf); r->_surfSynced = YES;
+        }
+    }
+    nvmtl_vk_tile4_content_set(sid, 0);
+    (void)nvmtl_vk_surface_gpu_mark2(sid, 2, 0);	// the pages are linear from now on (page-off writes them so)
+    nvmtl_po_register(r);
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 5 * (int64_t)NSEC_PER_SEC), dispatch_get_global_queue(QOS_CLASS_UTILITY, 0),
+                   ^{ (void)to; });	// holds the image over the pages until then
+    nvlog("ccs: surface %u %ux%u is drawn compressed and scanned so", sid, r->_i.w, r->_i.h);
+}
