+static void nvIopColourApply(void)
+{
+    if (!gIopColour || !gColourLock || gColourGen == gColourAppliedGen) return;
+    const uint64_t now = mach_absolute_time();
+    uint64_t ns = 0;
+    if (gColourLastApplyAbs) absolutetime_to_nanoseconds(now - gColourLastApplyAbs, &ns);
+    if (gColourLastApplyAbs && ns < (uint64_t)(gIopColourMs > 0 ? gIopColourMs : 0) * 1000000ull) return;
+    IOLockLock(gColourLock);
+    memcpy(&gColourApplyBuf, &gColourPend, sizeof gColourApplyBuf);
+    const uint32_t gen = gColourGen;
+    IOLockUnlock(gColourLock);
+    gColourApplyBuf.matrix_mode = (uint32_t)gIopColourMtx;
+    // §37.29: CoreDisplay hands the same tables over again about once a second as new objects; an unchanged state is
+    // not committed again (each commit is ~5 ms in the flip worker, a missed vblank)
+    static NVXgPipeColour last; static bool haveLast;
+    if (haveLast && !memcmp(&last, &gColourApplyBuf, sizeof last)) {
+        gColourAppliedGen = gen; OSAddAtomic64(1, &gCntColourSame);
+        return;
+    }
+    unsigned int us = 0; int res = -1;
+    const IOReturn r = nvAccelResidentCall("xgPipeColour", &gColourApplyBuf, &us, &res, nullptr);
+    gColourLastApplyAbs = mach_absolute_time();
+    gColourAppliedGen = gen;
+    gColourLastUs = us; if ((SInt64)us > gColourMaxUs) gColourMaxUs = us;
+    if (r == kIOReturnSuccess && res == 0) { OSAddAtomic64(1, &gCntColourApplied); memcpy(&last, &gColourApplyBuf, sizeof last); haveLast = true; }
+    else {
+        const SInt64 f = OSAddAtomic64(1, &gCntColourFail);
+        if (f < 8) ALOG("iop colour: the core refused the colour state (call 0x%x, result %d)", r, res);
+    }
+}
