+static pthread_once_t xg_trace_once = PTHREAD_ONCE_INIT;
+static int xg_trace_on;
+static _Atomic unsigned long long xg_trace_sequence;
+static _Atomic unsigned xg_trace_ok, xg_trace_errors;
+static _Thread_local unsigned long long xg_trace_current;
+static void xg_trace_init(void)
+{
+    const char *v = getenv("XEMTL_DRM_TRACE");
+    xg_trace_on = v && v[0] == '1' && v[1] == 0;
+}
+static void xg_trace_record(const char *route, int minor, unsigned long request,
+                            long kr, unsigned long long scalar, int result, int error)
+{
+    int saved = errno;
+    unsigned n;
+    uint64_t tid = 0;
+    struct timespec t;
+    pthread_once(&xg_trace_once, xg_trace_init);
+    if (!xg_trace_on) return;
+    n = result ? atomic_fetch_add(&xg_trace_errors, 1) : atomic_fetch_add(&xg_trace_ok, 1);
+    if (n < (result ? 64u : 512u)) {
+        pthread_threadid_np(NULL, &tid);
+        clock_gettime(CLOCK_MONOTONIC_RAW, &t);
+        syslog(result ? LOG_ERR : LOG_NOTICE,
+            "XEGFX_IOCTL pid=%d tid=%llu seq=%llu route=%s minor=%d request=%#lx group=%u nr=%u kr=%#lx scalar=%llu ret=%d errno=%d mono_ns=%llu",
+            getpid(), (unsigned long long)tid, xg_trace_current, route, minor, request,
+            (unsigned)((request >> 8) & 255), (unsigned)(request & 255), (unsigned long)kr,
+            scalar, result, error, (unsigned long long)t.tv_sec*1000000000ull+t.tv_nsec);
+    }
+    errno = saved;
+}
+
+/* ---------------------------------------------------------------------------------------------
+ * Detail probes for the two i915 ioctls behind the WindowServer "execbuf EFAULT" (device lost):
+ * GEM_USERPTR (a host import's source pages) and GEM_EXECBUFFER2 (the submit that returns EFAULT).
+ * Every probe reads through mach_vm_read_overwrite() on our own task, so a stale pointer cannot
+ * crash the caller. Enabled together with XEGFX_IOCTL by XEMTL_DRM_TRACE=1.
+ * ------------------------------------------------------------------------------------------- */
+struct xg_i915_userptr {
+    uint64_t user_ptr;
+    uint64_t user_size;
+    uint32_t flags;
+    uint32_t handle;
+};
+struct xg_i915_eb2 {
+    uint64_t buffers_ptr;
+    uint32_t buffer_count;
+    uint32_t batch_start_offset;
+    uint32_t batch_len;
+    uint32_t DR1;
+    uint32_t DR4;
+    uint32_t num_cliprects;
+    uint64_t cliprects_ptr;
+    uint64_t flags;
+    uint64_t rsvd1;
+    uint64_t rsvd2;
+};
+struct xg_i915_eo2 {
+    uint32_t handle;
+    uint32_t relocation_count;
+    uint64_t relocs_ptr;
+    uint64_t alignment;
+    uint64_t offset;
+    uint64_t flags;
+    uint64_t rsvd1;
+    uint64_t rsvd2;
+};
+struct xg_i915_uext {
+    uint64_t next_extension;
+    uint32_t name;
+    uint32_t flags;
+    uint32_t rsvd[4];
+};
+struct xg_i915_tl_ext {
+    struct xg_i915_uext base;
+    uint64_t fence_count;
+    uint64_t handles_ptr;
+    uint64_t values_ptr;
+};
+#define XG_I915_GEM_USERPTR_IOCTL 0xc0186473ul
+#define XG_I915_GEM_EXECBUFFER2_IOCTL 0x80406469ul
+#define XG_I915_EXEC_USE_EXTENSIONS (1ull << 21)
+
+static int xg_trace_read(uint64_t addr, void *out, size_t len)
+{
+    mach_vm_size_t got = 0;
+
+    if (addr == 0 || len == 0)
+        return -1;
+    if (mach_vm_read_overwrite(mach_task_self(), (mach_vm_address_t)addr, (mach_vm_size_t)len,
+                               (mach_vm_address_t)(uintptr_t)out, &got) != KERN_SUCCESS || got != len)
+        return -1;
+    return 0;
+}
+
+static int xg_trace_prot(uint64_t addr)
+{
+    mach_vm_address_t a = (mach_vm_address_t)addr;
+    mach_vm_size_t size = 0;
+    vm_region_basic_info_data_64_t info;
+    mach_msg_type_number_t count = VM_REGION_BASIC_INFO_COUNT_64;
+    mach_port_t object = MACH_PORT_NULL;
+    int prot = -1;
+
+    if (mach_vm_region(mach_task_self(), &a, &size, VM_REGION_BASIC_INFO_64,
+                       (vm_region_info_t)&info, &count, &object) == KERN_SUCCESS) {
+        prot = (int)info.protection;
+        if (object != MACH_PORT_NULL)
+            mach_port_deallocate(mach_task_self(), object);
+    }
+    return prot;
+}
+
+static void xg_trace_detail_before(unsigned long request, void *arg)
+{
+    int saved = errno;
+
+    pthread_once(&xg_trace_once, xg_trace_init);
+    if (!xg_trace_on || arg == NULL)
+        return;
+    if (request == XG_I915_GEM_USERPTR_IOCTL) {
+        struct xg_i915_userptr u;
+
+        if (xg_trace_read((uint64_t)(uintptr_t)arg, &u, sizeof(u)) != 0) {
+            syslog(LOG_ERR, "XEGFX_USERPTR_DETAIL pid=%d seq=%llu read_failed arg=%#llx",
+                   getpid(), xg_trace_current, (unsigned long long)(uintptr_t)arg);
+        } else {
+            syslog(LOG_NOTICE,
+                   "XEGFX_USERPTR_DETAIL pid=%d seq=%llu user_ptr=%#llx user_size=%llu flags=%#x page_off=%#llx prot=%#x end_prot=%#x",
+                   getpid(), xg_trace_current, (unsigned long long)u.user_ptr,
+                   (unsigned long long)u.user_size, u.flags, (unsigned long long)(u.user_ptr & 0xfffull),
+                   xg_trace_prot(u.user_ptr),
+                   u.user_size ? xg_trace_prot(u.user_ptr + u.user_size - 1) : -1);
+        }
+    } else if (request == XG_I915_GEM_EXECBUFFER2_IOCTL) {
+        struct xg_i915_eb2 e;
+        struct xg_i915_eo2 o[8];
+        int i, n, listed;
+
+        if (xg_trace_read((uint64_t)(uintptr_t)arg, &e, sizeof(e)) != 0) {
+            syslog(LOG_ERR, "XEGFX_EXEC_DETAIL pid=%d seq=%llu read_failed arg=%#llx",
+                   getpid(), xg_trace_current, (unsigned long long)(uintptr_t)arg);
+            errno = saved;
+            return;
+        }
+        n = (int)e.buffer_count;
+        if (n > 8)
+            n = 8;
+        listed = 0;
+        if (n > 0 && xg_trace_read(e.buffers_ptr, o, (size_t)n * sizeof(o[0])) == 0) {
+            listed = 1;
+            for (i = 0; i < n; i++)
+                syslog(LOG_NOTICE,
+                       "XEGFX_EXEC_OBJ pid=%d seq=%llu idx=%d handle=%u reloc_count=%u relocs=%#llx alignment=%#llx offset=%#llx flags=%#llx",
+                       getpid(), xg_trace_current, i, o[i].handle, o[i].relocation_count,
+                       (unsigned long long)o[i].relocs_ptr, (unsigned long long)o[i].alignment,
+                       (unsigned long long)o[i].offset, (unsigned long long)o[i].flags);
+        }
+        syslog(LOG_NOTICE,
+               "XEGFX_EXEC_DETAIL pid=%d seq=%llu buffers=%#llx count=%u start=%u len=%u DR1=%u DR4=%u num_clip=%u cliprects=%#llx flags=%#llx rsvd1=%#llx rsvd2=%#llx listed=%d",
+               getpid(), xg_trace_current, (unsigned long long)e.buffers_ptr, e.buffer_count,
+               e.batch_start_offset, e.batch_len, e.DR1, e.DR4, e.num_cliprects,
+               (unsigned long long)e.cliprects_ptr, (unsigned long long)e.flags,
+               (unsigned long long)e.rsvd1, (unsigned long long)e.rsvd2, listed);
+        if ((e.flags & XG_I915_EXEC_USE_EXTENSIONS) != 0) {
+            uint64_t next = e.cliprects_ptr;
+
+            for (i = 0; i < 4 && next != 0; i++) {
+                struct xg_i915_tl_ext t;
+
+                if (xg_trace_read(next, &t, sizeof(t)) != 0) {
+                    syslog(LOG_ERR, "XEGFX_EXEC_EXT pid=%d seq=%llu idx=%d unreadable=%#llx",
+                           getpid(), xg_trace_current, i, (unsigned long long)next);
+                    break;
+                }
+                syslog(LOG_NOTICE, "XEGFX_EXEC_EXT pid=%d seq=%llu idx=%d name=%u flags=%#x next=%#llx",
+                       getpid(), xg_trace_current, i, t.base.name, t.base.flags,
+                       (unsigned long long)t.base.next_extension);
+                if (t.base.name == 0)
+                    syslog(LOG_NOTICE,
+                           "XEGFX_EXEC_EXT_TL pid=%d seq=%llu fence_count=%llu handles=%#llx values=%#llx",
+                           getpid(), xg_trace_current, (unsigned long long)t.fence_count,
+                           (unsigned long long)t.handles_ptr, (unsigned long long)t.values_ptr);
+                next = t.base.next_extension;
+            }
+        }
+    }
+    errno = saved;
+}
+
+static void xg_trace_detail_before(unsigned long request, void *arg);
+
+static void xg_trace_detail_after(unsigned long request, void *arg, int result, int error)
+{
+    int saved = errno;
+
+    pthread_once(&xg_trace_once, xg_trace_init);
+    if (!xg_trace_on)
+        return;
+    /* A submit is dumped only when it fails: the arguments stay valid until execbuf returns, and
+     * dumping every submit would cost more than the submission itself. */
+    if (result != 0 && request == XG_I915_GEM_EXECBUFFER2_IOCTL)
+        xg_trace_detail_before(request, arg);
+    if ((request == XG_I915_GEM_USERPTR_IOCTL || request == XG_I915_GEM_EXECBUFFER2_IOCTL) && result != 0)
+        syslog(LOG_ERR, "XEGFX_DETAIL_RESULT pid=%d seq=%llu request=%#lx ret=%d errno=%d",
+               getpid(), xg_trace_current, request, result, error);
+    errno = saved;
+}
