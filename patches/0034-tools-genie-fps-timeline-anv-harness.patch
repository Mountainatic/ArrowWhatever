+#!/bin/sh
+# diff-one.sh <hash>: render one lowered fragment shader low/<hash>.spv with ANV's pushes off and on (diff-test) and
+# compare the pixels.  Prints "<hash> same", "DIFF", "fail" or "vsgen-skip".  Run from this directory after building
+# diff-test; XEGFX_ICD names the ICD json (default: the installed /Library/GPUBundles/xemtl/intel_icd.json).
+# Usage: ls low | sed 's/.spv//' | xargs -P6 -n1 ./diff-one.sh
+h=$1; ICD=${XEGFX_ICD:-/Library/GPUBundles/xemtl/intel_icd.json}
+mkdir -p vs out
+python3 gen_vs.py low/$h.spv vs/$h.spv >/dev/null 2>&1 || { echo "$h vsgen-skip"; exit 0; }
+for p in 0 1; do env VK_ICD_FILENAMES=$ICD MESA_SHADER_CACHE_DISABLE=true XEMTL_SSBO_PUSH=$p ./diff-test vs/$h.spv low/$h.spv out/$h.$p.bin > out/$h.$p.txt 2>&1; done
+if grep -q FAIL out/$h.0.txt; then echo "$h fail $(grep FAIL out/$h.0.txt | head -1 | cut -c1-80)"; elif cmp -s out/$h.0.bin out/$h.1.bin; then echo "$h same"; else echo "$h DIFF"; fi
