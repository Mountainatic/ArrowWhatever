+/* "xgSurfTicket" (xg_kext.cpp): md is the surface's descriptor, task the caller's; 0 and *ticket set, or -errno */
+int
+xg_surf_ticket(void *md, void *task, unsigned int *ticket, unsigned long long *size)
+{
+	struct xg_ticket *t;
+	const u64 now = ktime_get_ns();
+	LIST_HEAD(stale);
+	u64 len;
+
+	if (md == NULL || task == NULL || ticket == NULL || size == NULL)
+		return -EINVAL;
+	len = xg_md_length(md);
+	if (len == 0 || len > (4ull << 30))
+		return -EINVAL;
+	t = kzalloc(sizeof(*t), GFP_KERNEL);
+	if (t == NULL)
+		return -ENOMEM;
+	xg_md_retain(md);
+	t->md = md;
+	t->task = task;
+	t->size = round_up(len, PAGE_SIZE);
+	t->born = now;
+	mutex_lock(&xg_surf_lock);
+	xg_surf_expire_locked(now, &stale);
+	if (++xg_ticket_next == 0)
+		xg_ticket_next = 1;
+	t->id = xg_ticket_next;
+	list_add_tail(&t->link, &xg_tickets);
+	mutex_unlock(&xg_surf_lock);
+	xg_surf_drop_list(&stale);
+	*ticket = t->id;
+	*size = t->size;
 	return 0;
 }
 
+/* SURF_EXPECT: the caller's ticket, for the userptr import of [user_ptr, user_ptr + user_size) on this file */
+static int
+xg_surf_expect(void *key, struct xg_drm_surf_expect *a)
+{
+	struct xg_ticket *t = NULL, *e;
+	void *task = xg_current_task();
+
+	if (a->user_ptr == 0 || a->user_size == 0 || (a->user_ptr & (PAGE_SIZE - 1)) || (a->user_size & (PAGE_SIZE - 1)))
+		return -EINVAL;
+	mutex_lock(&xg_surf_lock);
+	list_for_each_entry(e, &xg_tickets, link)
+		if (e->id == a->ticket && e->task == task) {
+			t = e;
+			break;
+		}
+	if (t != NULL && a->user_size <= t->size) {
+		t->key = key;
+		t->user_ptr = a->user_ptr;
+		t->user_size = a->user_size;
+		t->born = ktime_get_ns();
+		list_move_tail(&t->link, &xg_expects);
+		mutex_unlock(&xg_surf_lock);
+		return 0;
+	}
+	if (t != NULL)	/* larger than the surface: the plain userptr it will be */
+		list_del(&t->link);
+	mutex_unlock(&xg_surf_lock);
+	if (t != NULL) {
+		xg_md_drop(t->md, 0);
+		kfree(t);
+		return -E2BIG;
+	}
+	return -ENOENT;
+}
