+/*
+ * Per-frame flip ordering (native-display docs/32-FRAME-RATE.md §32.14).  "Every engine idle" (xg_i915_idle) waits for
+ * everybody's work, including work queued after the frame, and a GPU that never goes idle (a video, a game) only ends at
+ * the accelerator's timeout, which then shows the frame unfinished.  Instead the accelerator takes a snapshot when the
+ * compositor's transaction arrives -- the last request of every active timeline, i.e. everything submitted so far, the
+ * composite included (the XeMTL plugin reports "scheduled" only after its execbuffer) -- and the flip worker waits for
+ * exactly those fences.  Waiting through dma_fence_wait_timeout also gives the GPU i915's waitboost.
+ */
+#define XG_FLIP_SNAP_MAX 64
+struct xg_flip_snap {
+	unsigned int		 n;
+	int			 overflow;
+	struct dma_fence	*f[XG_FLIP_SNAP_MAX];
+};
+
+/* thread context, does not sleep: a spinlock and RCU fence references.  NULL with no i915 or no memory */
+void *
+xg_i915_flip_snapshot(void)
+{
+	struct pci_dev *pdev = NULL;
+	struct drm_i915_private *i915 = xg_i915_find(&pdev);
+	struct intel_gt_timelines *timelines;
+	struct intel_timeline *tl;
+	struct xg_flip_snap *snap;
+	struct dma_fence *extra = NULL;
+
+	if (!i915)
+		return (NULL);
+	snap = kzalloc(sizeof(*snap), GFP_NOWAIT);
+	if (snap == NULL)
+		return (NULL);
+	timelines = &to_gt(i915)->timelines;
+	spin_lock(&timelines->lock);
+	list_for_each_entry(tl, &timelines->active_list, link) {
+		struct dma_fence *f = i915_active_fence_get(&tl->last_request);
+
+		if (f == NULL)
+			continue;
+		if (snap->n == XG_FLIP_SNAP_MAX) {
+			snap->overflow = 1;
+			extra = f;	/* a put can free the request: not under the timelines lock */
+			break;
+		}
+		snap->f[snap->n++] = f;
+	}
+	spin_unlock(&timelines->lock);
+	if (extra != NULL)
+		dma_fence_put(extra);
+	return (snap);
 }
+
+/* 1 every fence of the snapshot signalled, 0 timeout, -1 the snapshot overflowed (wait for idle instead).  Sleeps */
+int
+xg_i915_flip_snap_wait(void *s, unsigned int timeout_ms, unsigned int *fences)
+{
+	struct xg_flip_snap *snap = s;
+	long left = msecs_to_jiffies(timeout_ms ? timeout_ms : 1);
+	unsigned int i;
+
+	if (snap == NULL)
+		return (-1);
+	if (fences != NULL)
+		*fences = snap->n;
+	for (i = 0; i < snap->n; i++) {
+		long r;
+
+		if (dma_fence_is_signaled(snap->f[i]))
+			continue;
+		r = dma_fence_wait_timeout(snap->f[i], false, left);
+		if (r <= 0)
+			return (0);
+		left = r;
+	}
+	return (snap->overflow ? -1 : 1);
+}
+
+void
+xg_i915_flip_snap_free(void *s)
+{
+	struct xg_flip_snap *snap = s;
+	unsigned int i;
+
+	if (snap == NULL)
+		return;
+	for (i = 0; i < snap->n; i++)
+		dma_fence_put(snap->f[i]);
+	kfree(snap);
+}
