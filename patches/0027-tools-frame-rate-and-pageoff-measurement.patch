--- /dev/null
+++ b/tools/screen-fps.m
@@ -0,0 +1,73 @@
+// screen-fps: how many new frames WindowServer puts on the main display per second.  A ScreenCaptureKit stream with no
+// minimum frame interval is handed a "complete" frame for every screen update (idle ones are skipped), so the count is
+// the compositor's real output rate.  Prints the rate, the longest gap and 100 ms buckets.  Read-only; needs Screen
+// Recording permission for the app that runs it.
+// Build: clang -fobjc-arc -framework Foundation -framework ScreenCaptureKit -framework CoreMedia screen-fps.m -o screen-fps
+// Usage: screen-fps [seconds=6]
+#import <Foundation/Foundation.h>
+#import <ScreenCaptureKit/ScreenCaptureKit.h>
+#import <CoreMedia/CoreMedia.h>
+#include <mach/mach_time.h>
+
+static double now(void)
+{
+    static mach_timebase_info_data_t tb;
+    if (!tb.denom) mach_timebase_info(&tb);
+    return (double)mach_absolute_time() * tb.numer / tb.denom / 1e9;
+}
+
+static int gBucket[1024], gN;
+static double gT0, gLast, gMaxGap;
+
+@interface Counter : NSObject <SCStreamOutput>
+@end
+@implementation Counter
+- (void)stream:(SCStream *)stream didOutputSampleBuffer:(CMSampleBufferRef)sb ofType:(SCStreamOutputType)type
+{
+    if (type != SCStreamOutputTypeScreen) return;
+    CFArrayRef att = CMSampleBufferGetSampleAttachmentsArray(sb, false);
+    if (!att || !CFArrayGetCount(att)) return;
+    NSDictionary *a = (__bridge NSDictionary *)CFArrayGetValueAtIndex(att, 0);
+    if ([a[SCStreamFrameInfoStatus] integerValue] != SCFrameStatusComplete) return;
+    const double t = now();
+    if (!gT0) gT0 = t;
+    if (gLast && t - gLast > gMaxGap) gMaxGap = t - gLast;
+    gLast = t; gN++;
+    const int b = (int)((t - gT0) * 10);
+    if (b >= 0 && b < 1024) gBucket[b]++;
+}
+@end
+
+int main(int argc, char **argv)
+{
+    @autoreleasepool {
+        const double secs = argc > 1 ? atof(argv[1]) : 6;
+        dispatch_semaphore_t got = dispatch_semaphore_create(0);
+        __block SCShareableContent *content = nil; __block NSError *err = nil;
+        [SCShareableContent getShareableContentWithCompletionHandler:^(SCShareableContent *c, NSError *e) { content = c; err = e; dispatch_semaphore_signal(got); }];
+        dispatch_semaphore_wait(got, DISPATCH_TIME_FOREVER);
+        if (!content.displays.count) { fprintf(stderr, "no shareable display (Screen Recording permission?) %s\n", err.description.UTF8String); return 1; }
+        SCDisplay *disp = content.displays[0];
+        SCContentFilter *filter = [[SCContentFilter alloc] initWithDisplay:disp excludingWindows:@[]];
+        SCStreamConfiguration *cfg = [SCStreamConfiguration new];
+        cfg.width = disp.width / 4; cfg.height = disp.height / 4;   // small: the copy must not be what limits the rate
+        cfg.minimumFrameInterval = kCMTimeZero;
+        cfg.queueDepth = 8; cfg.showsCursor = NO;
+        SCStream *s = [[SCStream alloc] initWithFilter:filter configuration:cfg delegate:nil];
+        Counter *c = [Counter new];
+        dispatch_queue_t q = dispatch_queue_create("frames", DISPATCH_QUEUE_SERIAL);
+        if (![s addStreamOutput:c type:SCStreamOutputTypeScreen sampleHandlerQueue:q error:&err]) { fprintf(stderr, "output: %s\n", err.description.UTF8String); return 1; }
+        [s startCaptureWithCompletionHandler:^(NSError *e) { err = e; dispatch_semaphore_signal(got); }];
+        dispatch_semaphore_wait(got, DISPATCH_TIME_FOREVER);
+        if (err) { fprintf(stderr, "start: %s\n", err.description.UTF8String); return 1; }
+        [NSThread sleepForTimeInterval:secs];
+        [s stopCaptureWithCompletionHandler:^(NSError *e) { dispatch_semaphore_signal(got); }];
+        dispatch_semaphore_wait(got, DISPATCH_TIME_FOREVER);
+        dispatch_sync(q, ^{});
+        printf("%d frames in %.1f s = %.1f/s, longest gap %.1f ms (display %ldx%ld)\nper 100 ms:", gN, secs, gN / secs,
+               gMaxGap * 1e3, (long)disp.width, (long)disp.height);
+        for (int i = 0; i < (int)(secs * 10) && i < 1024; i++) printf(" %d", gBucket[i]);
+        printf("\n");
+    }
+    return 0;
+}
