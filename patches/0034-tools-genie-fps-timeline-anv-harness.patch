+// map-test: largest host-visible allocation that can be mapped now (vkAllocateMemory + vkMapMemory), in MB steps
+#include <vulkan/vulkan.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <time.h>
+int main(int argc, char **argv)
+{
+    setvbuf(stdout, NULL, _IONBF, 0);
+    VkApplicationInfo ai = { VK_STRUCTURE_TYPE_APPLICATION_INFO, NULL, "map", 1, NULL, 0, VK_API_VERSION_1_3 };
+    VkInstanceCreateInfo ii = { VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO, NULL, 0, &ai };
+    VkInstance inst; if (vkCreateInstance(&ii, NULL, &inst)) return 1;
+    uint32_t n = 1; VkPhysicalDevice pd; vkEnumeratePhysicalDevices(inst, &n, &pd);
+    float pr = 1; VkDeviceQueueCreateInfo qi = { VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO, NULL, 0, 0, 1, &pr };
+    VkDeviceCreateInfo di = { VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO, NULL, 0, 1, &qi };
+    VkDevice dev; if (vkCreateDevice(pd, &di, NULL, &dev)) return 1;
+    VkPhysicalDeviceMemoryProperties mp; vkGetPhysicalDeviceMemoryProperties(pd, &mp);
+    uint32_t mt = 0; for (; mt < mp.memoryTypeCount; mt++) if (mp.memoryTypes[mt].propertyFlags & VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT) break;
+    for (int i = 1; i < argc; i++) {
+        VkDeviceSize sz = (VkDeviceSize)atoi(argv[i]) << 20;
+        VkMemoryAllocateInfo ma = { VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO, NULL, sz, mt };
+        VkDeviceMemory m; struct timespec t0, t1; clock_gettime(CLOCK_MONOTONIC, &t0);
+        VkResult r = vkAllocateMemory(dev, &ma, NULL, &m); void *p = NULL;
+        VkResult r2 = r ? r : vkMapMemory(dev, m, 0, sz, 0, &p);
+        clock_gettime(CLOCK_MONOTONIC, &t1);
+        printf("%s MB: alloc %d map %d (%.0f ms)\n", argv[i], r, r2, (t1.tv_sec - t0.tv_sec) * 1e3 + (t1.tv_nsec - t0.tv_nsec) / 1e6);
+        if (!r) { if (!r2) vkUnmapMemory(dev, m); vkFreeMemory(dev, m, NULL); }
+    }
+    return 0;
+}
