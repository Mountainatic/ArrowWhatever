+	return (snprintf(out, max, "slpc %d act %u req %u min %u max %u rp0 %u rp1 %u rpn %u boost %u MHz",
+	    intel_uc_uses_guc_slpc(&to_gt(i915)->uc) ? 1 : 0, intel_rps_read_actual_frequency(rps),
+	    intel_rps_get_requested_frequency(rps), intel_rps_get_min_frequency(rps), intel_rps_get_max_frequency(rps),
+	    intel_rps_get_rp0_frequency(rps), intel_rps_get_rp1_frequency(rps), intel_rps_get_rpn_frequency(rps),
+	    intel_rps_get_boost_frequency(rps)));
+}
