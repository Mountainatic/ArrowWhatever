+/*
+ * "xgScanoutPhys" (xg_kext.cpp): the physical address of every 4 KiB page of token's object, as xg_flip_map takes
+ * them; *npages and *bytes say how many there are.  -ENOSPC (with both set) when cap is too small.
+ */
+int
+xg_scanout_bo_phys(unsigned int token, unsigned long long *phys, unsigned int cap, unsigned int *npages,
+    unsigned long long *bytes)
+{
+	struct sg_table *sgt;
+	struct scatterlist *sg;
+	struct xg_scan *e, *found = NULL;
+	unsigned int i, n = 0, need;
+	int err = 0;
+
+	if (token == 0 || npages == NULL || bytes == NULL)
+		return -EINVAL;
+	mutex_lock(&xg_scans_lock);
+	list_for_each_entry(e, &xg_scans, link)
+		if (e->token == token) {
+			found = e;
+			break;
+		}
+	if (found == NULL) {
+		mutex_unlock(&xg_scans_lock);
+		return -ENOENT;
+	}
+	*bytes = found->obj->base.size;
+	need = (unsigned int)(found->obj->base.size >> 12);
+	*npages = need;
+	if (phys == NULL || cap < need) {
+		mutex_unlock(&xg_scans_lock);
+		return -ENOSPC;
+	}
+	sgt = found->obj->mm.pages;
+	for_each_sg(sgt->sgl, sg, sgt->orig_nents, i) {
+		u64 p, off;
+
+		if (sg_page(sg) == NULL) {
+			err = -ENODEV;
+			break;
+		}
+		p = page_to_phys(sg_page(sg)) + sg->offset;
+		for (off = 0; off < sg->length && n < need; off += 4096)
+			phys[n++] = p + off;
+		if (n == need)
+			break;
+	}
+	mutex_unlock(&xg_scans_lock);
+	if (err == 0 && n != need)
+		err = -EINVAL;
+	return err;
+}
