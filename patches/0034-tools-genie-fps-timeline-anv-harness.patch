+#!/Library/Developer/CommandLineTools/usr/bin/python3
+# xegfx-livelog: survives a hard hang.  Streams our kexts' and WindowServer's display messages from the unified log
+# (which keeps them in memory and loses the tail on a forced reboot) into /var/log/xegfx-live/, fsynced every 0.25 s,
+# and writes a heartbeat line every second with the display counters.  The last heartbeat before a hang says when user
+# space stopped; the last messages say what the driver was doing.  Diagnostics only: it changes nothing in the driver.
+import os, subprocess, sys, threading, time
+
+DIR = '/var/log/xegfx-live'
+KEEP = 12
+PRED = ('(process == "kernel" AND (sender BEGINSWITH "XeGfx" OR sender BEGINSWITH "NV" OR eventMessage CONTAINS[c] "panic"'
+        ' OR eventMessage CONTAINS "watchdog")) OR (process == "WindowServer" AND (subsystem == "com.apple.CoreDisplay"'
+        ' OR sender == "XeMTLDriver")) OR (process == "loginwindow" AND messageType == error)')
+SYSCTLS = ['debug.xegfxaccel_iop_xe_flips', 'debug.xegfxaccel_iop_xe_early', 'debug.xegfxaccel_iop_xe_early_signals',
+           'debug.xegfxaccel_iop_xe_mark_timeouts', 'debug.xegfxaccel_iop_xe_idle_forced', 'debug.xegfxaccel_iop_xe_tile4_frames',
+           'debug.xegfx_agdc_k5_colour_answers', 'vm.page_free_count']
+
+os.makedirs(DIR, exist_ok=True)
+names = sorted(f for f in os.listdir(DIR) if f.endswith('.log'))
+for f in names[:-(KEEP - 1)] if len(names) >= KEEP else []:
+    try: os.unlink(os.path.join(DIR, f))
+    except OSError: pass
+boot = subprocess.run(['/usr/sbin/sysctl', '-n', 'kern.bootsessionuuid'], capture_output=True, text=True).stdout.strip()[:8]
+path = os.path.join(DIR, time.strftime('%Y%m%d-%H%M%S-') + boot + '.log')
+out = open(path, 'a', buffering=1)
+lock = threading.Lock()
+dirty = [False]
+
+def write(line):
+    with lock:
+        out.write(line if line.endswith('\n') else line + '\n'); dirty[0] = True
+
+def syncer():
+    while True:
+        time.sleep(0.25)
+        with lock:
+            if dirty[0]:
+                out.flush(); os.fsync(out.fileno()); dirty[0] = False
+
+def heartbeat():
+    n = 0
+    while True:
+        try:
+            r = subprocess.run(['/usr/sbin/sysctl'] + SYSCTLS, capture_output=True, text=True, timeout=5).stdout
+            vals = ' '.join(l.split(': ', 1)[0].split('.')[-1] + '=' + l.split(': ', 1)[1] for l in r.splitlines() if ': ' in l)
+        except Exception as e:
+            vals = 'sysctl failed: %r' % e
