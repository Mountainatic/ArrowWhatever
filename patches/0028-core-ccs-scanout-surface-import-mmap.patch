+static const struct drm_i915_gem_object_ops xg_surf_ops = {
+	.name = "xg_iosurface",
+	.get_pages = xg_surf_get_pages,
+	.put_pages = xg_surf_put_pages,
+	.release = xg_surf_release,
+};
