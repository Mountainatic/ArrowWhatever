+// §37.15 (native-display docs/37-RENDER-COMPRESSION.md): every display register read here is recorded on the core's
+// per-CPU watchdog slot while it is in flight ("xgMmioHooks"), so the core's irq-off panic report names a CPU stuck in
+// one of our reads (a read the display never completes stalls the CPU even for an NMI).  Until the hooks are fetched
+// (the first flip) reads go unrecorded.
+typedef void (*NVXeMmioBegin)(const volatile void *addr, int who);
+typedef void (*NVXeMmioEnd)(void);
+static NVXeMmioBegin gXeMmioBegin;
+static NVXeMmioEnd gXeMmioEnd;
+static inline uint32_t nvXeRd(uint32_t off)
+{
+    const volatile uint32_t *a = &gDispMmio[off / 4];
+    const NVXeMmioBegin b = gXeMmioBegin; const NVXeMmioEnd e = gXeMmioEnd;
+    if (b && e) { b(a, 2); const uint32_t v = *a; e(); return v; }
+    return *a;
+}
