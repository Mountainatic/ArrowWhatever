+	mutex_lock(&xg_scans_lock);
+	list_for_each_entry(e, &xg_scans, link)
+		if (e->key == key && e->token == a->token) {
+			list_del(&e->link);
+			found = e;
+			break;
+		}
+	mutex_unlock(&xg_scans_lock);
+	if (found == NULL)
+		return -EINVAL;
+	xg_scan_free(found);
