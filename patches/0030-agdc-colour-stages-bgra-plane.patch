+// §37.12: the display pipe's colour stages, answered the way Apple's ICL framebuffer answers them for its built-in panel
+// (getDisplayPipeCapabilityExtended: type 1 = the CSC matrix range, types 2 and 4 = 1024-entry tables; one generic
+// entry each, without Intel's vendor-specific second entry).  Without these CoreDisplay finds "plane with no gamma"
+// and runs its GPUPass (a full-screen LUT pass) before every scanout.  Each entry is offset 0xc into the reply.
+static inline void nvk5_putf(uint8_t *e, unsigned off, uint32_t bits) { nvk5_put32(e, off, bits); }
+static inline int nvk5_fill_colour(struct NVAGDCFBExtCap *c)
+{
+    uint32_t idx = c->fbIndex, type = c->type; uint8_t *e = c->entry[0];
+    if (type != 1 && type != 2 && type != 4) return 0;
+    nvk5_zero(c, sizeof *c); c->fbIndex = idx; c->type = type; c->count = 1;
+    if (type == 1) {
+        nvk5_put32(e, 0x00, 5); nvk5_put32(e, 0x10, 8); nvk5_put32(e, 0x20, 0x30700);
+        nvk5_putf(e, 0x24, 0xbf800000u); nvk5_putf(e, 0x28, 0x3f800000u);            // -1.0 .. 1.0
+    } else {
+        nvk5_put32(e, 0x00, type == 2 ? 0x101001u : 0x100001u);
+        nvk5_put32(e, 0x04, type == 2 ? 3u : 2u);
+        nvk5_putf(e, 0x0c, type == 2 ? 0x41480000u : 0x40855555u);                   // 3 x / 1 x a 240 Hz frame, ms
+        nvk5_put32(e, 0x10, type == 2 ? 0x10u : 0x8u);
+        nvk5_putf(e, 0x20, 0); nvk5_putf(e, 0x24, 0x3f800000u);                      // 0.0 .. 1.0
+        nvk5_put32(e, 0x28, 0x400);                                                   // 1024 entries
+    }
+    return 1;
+}
