+# sweep.py MIN=16,MAXLEN=64 ...: total SENDs / cycles of the lowered shaders in ws/ for XEMTL_PTR_PUSH_* settings, against
+# pushes off, with the shaders that got worse.  XEGFX_ICD names the ICD json (default: the installed one).
+import subprocess, re, os, sys, glob
+S = os.path.dirname(os.path.abspath(__file__))
+icd = os.environ.get('XEGFX_ICD', '/Library/GPUBundles/xemtl/intel_icd.json')
+def st(spv, env):
+    e = dict(os.environ, VK_ICD_FILENAMES=icd, MESA_SHADER_CACHE_DISABLE='true', **env)
+    o = subprocess.run([os.path.join(S, 'ssbo-push-test'), 'real', spv], capture_output=True, text=True, env=e).stdout
+    m = re.search(r'SIMD16 fragment: SENDs=(\d+) Cycles=(\d+) Spills=(\d+) Fills=(\d+)', o) or re.search(r'SIMD8 fragment: SENDs=(\d+) Cycles=(\d+) Spills=(\d+) Fills=(\d+)', o)
+    return tuple(int(m.group(i)) for i in range(1, 5)) if m else None
+spvs = sorted(glob.glob(os.path.join(S, 'ws', '*.spv')))
+base = {p: st(p, {'XEMTL_SSBO_PUSH': '0'}) for p in spvs}
+for mn in sys.argv[1:]:
+    tot0 = tot1 = c0 = c1 = worse = changed = 0; wl = []
+    for p in spvs:
+        env = {'XEMTL_SSBO_PUSH': '1'}
+        for kv in mn.split(','):
+            k, v = kv.split('='); env['XEMTL_PTR_PUSH_' + k] = v
+        a = base[p]; b = st(p, env)
+        if not a or not b: continue
+        tot0 += a[0]; tot1 += b[0]; c0 += a[1]; c1 += b[1]
+        if a != b: changed += 1
+        if b[1] > a[1]: worse += 1; wl.append((os.path.basename(p)[:8], a, b))
+    print('%s: changed %d, SENDs %d -> %d, cycles %d -> %d (%.1f%%), worse %d %s' % (mn, changed, tot0, tot1, c0, c1, 100.0 * (c1 - c0) / c0, worse, sorted(wl, key=lambda w: w[1][1] - w[2][1])[:5]))
