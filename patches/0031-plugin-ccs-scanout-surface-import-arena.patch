+// <wtl> §37.17 (native-display docs/37-RENDER-COMPRESSION.md): image memory from a few large blocks.  ANV puts the BO of
+// every VkDeviceMemory into every execbuffer (i915/anv_batch_chain.c: bindless use cannot be tracked), and each image had
+// its own: WindowServer's submits carried ~300 BOs each (debug.xegfx_eb), the execbuffer ioctl blocked in the kernel for
+// most of the submit, and genie made and freed ~140 images a second, each a gem_create + mmap ioctl.  Images up to 8 MiB
+// now take a range of a 64 MiB block (per memory type).  ANV keeps compression for them: a non-dedicated allocation on
+// this GPU is an AUX-TT aligned BO with its CCS at the end (ANV_BO_ALLOC_AUX_CCS), and the aux table is mapped from the
+// image's address rounded down to 1 MiB.  An image is destroyed only after the command buffers that used it completed
+// (they retain it), so its range is free for reuse at once.  First fit, ranges coalesce; a block with nothing live goes
+// unless it is the type's last.  /Library/GPUBundles/.xemtl-no-arena or XEMTL_NO_ARENA=1 at start: one memory per image.
+typedef struct nvmtl_arena_range { uint64_t off, size; struct nvmtl_arena_range *next; } nvmtl_arena_range;
+typedef struct nvmtl_arena { VkDeviceMemory mem; uint32_t mt; uint64_t size, live_bytes; unsigned live; nvmtl_arena_range *free; struct nvmtl_arena *next; } nvmtl_arena;
+#define NVMTL_ARENA_BLOCK (64ull << 20)
+#define NVMTL_ARENA_MAX (8ull << 20)
