@@ -0,0 +1,13 @@
+// sysctl-once: reads a string sysctl with one call into a large buffer.  sysctl(8) asks the size first, and the core's
+// counters that restart at every read (debug.xegfx_eb, debug.xegfx_rq) would then print an empty second read.
+// Build: clang sysctl-once.c -o sysctl-once      Usage: sysctl-once debug.xegfx_rq
+#include <stdio.h>
+#include <sys/sysctl.h>
+int main(int argc, char **argv)
+{
+    static char buf[65536];
+    size_t n = sizeof buf - 1;
+    if (argc < 2 || sysctlbyname(argv[1], buf, &n, NULL, 0) != 0) { perror(argc > 1 ? argv[1] : "usage: sysctl-once name"); return 1; }
+    buf[n] = 0; fputs(buf, stdout);
+    return 0;
+}
