+#!/usr/bin/env python3
+# Extract one fileset entry of an x86_64 kernel collection as a standalone Mach-O (segments + symtab), for otool/nm.
+import struct, sys
+
+LC_SEGMENT_64, LC_SYMTAB, LC_DYSYMTAB, LC_FILESET_ENTRY = 0x19, 0x2, 0xb, 0x80000035
+
+def entries(kc):
+    ncmds, sizeofcmds = struct.unpack_from('<II', kc, 16)
+    off = 32
+    for _ in range(ncmds):
+        cmd, size = struct.unpack_from('<II', kc, off)
+        if cmd == LC_FILESET_ENTRY:
+            vmaddr, fileoff, idoff = struct.unpack_from('<QQI', kc, off + 8)
+            name = kc[off + idoff: kc.index(b'\0', off + idoff)].decode()
+            yield name, vmaddr, fileoff
+        off += size
+
+def extract(kc, fileoff):
+    magic, cpu, sub, ftype, ncmds, sizeofcmds, flags, _ = struct.unpack_from('<IiiIIIII', kc, fileoff)
+    hdr = bytearray(kc[fileoff: fileoff + 32 + sizeofcmds])
+    out = bytearray()
+    segs, symtab, led = [], None, []
+    off = 32
+    for _ in range(ncmds):
+        cmd, size = struct.unpack_from('<II', hdr, off)
+        if cmd == LC_SEGMENT_64:
+            segs.append(off)
+        elif cmd == LC_SYMTAB:
+            symtab = off
+        elif cmd == LC_DYSYMTAB:
+            hdr[off + 8: off + size] = bytes(size - 8)   # indirect tables are not carried over
+        elif cmd in (0x26, 0x29, 0x1e, 0x80000033, 0x80000034):
+            led.append(off)                              # linkedit_data_command: carried over below
+        off += size
+    # lay segments out page by page after the header
+    cur = (len(hdr) + 0xfff) & ~0xfff
+    body = {}
+    for so in segs:
+        name = hdr[so + 8: so + 24].rstrip(b'\0').decode()
+        vmaddr, vmsize, sfoff, sfsize = struct.unpack_from('<QQQQ', hdr, so + 24)
+        nsects = struct.unpack_from('<I', hdr, so + 64)[0]
+        if name == '__LINKEDIT' or sfsize == 0:
+            struct.pack_into('<QQ', hdr, so + 40, 0, 0)
+            continue
+        body[cur] = kc[sfoff: sfoff + sfsize]
+        delta = cur - sfoff
+        struct.pack_into('<Q', hdr, so + 40, cur)
+        for i in range(nsects):
+            s = so + 72 + 80 * i
+            soff = struct.unpack_from('<I', hdr, s + 48)[0]
+            if soff:
+                struct.pack_into('<I', hdr, s + 48, soff + delta)
+            struct.pack_into('<II', hdr, s + 56, 0, 0)      # relocations dropped
+        cur = (cur + sfsize + 0xfff) & ~0xfff
+    if symtab is not None:
+        symoff, nsyms, stroff, strsize = struct.unpack_from('<IIII', hdr, symtab + 8)
+        syms = kc[symoff: symoff + nsyms * 16]
+        strs = kc[stroff: stroff + strsize]
+        body[cur] = syms
+        body[cur + len(syms)] = strs
+        struct.pack_into('<IIII', hdr, symtab + 8, cur, nsyms, cur + len(syms), strsize)
+        cur += len(syms) + strsize
+    for lo in led:
+        doff, dsize = struct.unpack_from('<II', hdr, lo + 8)
+        if dsize:
+            body[cur] = kc[doff: doff + dsize]
+            struct.pack_into('<I', hdr, lo + 8, cur)
+            cur += (dsize + 7) & ~7
+    out = bytearray(cur)
+    out[0: len(hdr)] = hdr
+    for o, b in body.items():
+        out[o: o + len(b)] = b
+    return bytes(out)
+
+kc = open(sys.argv[1], 'rb').read()
+want = sys.argv[2:]
+for name, vmaddr, fileoff in entries(kc):
+    if not want:
+        print(name)
+    elif name in want:
+        data = extract(kc, fileoff)
+        open(name + '.macho', 'wb').write(data)
+        print('%s vmaddr 0x%x -> %s.macho (%d bytes)' % (name, vmaddr, name, len(data)))
