+// plower: the plugin's fragment/vertex module preparation (nvmtl_vk.c nvmtl_address_shader), offline
+#import <Foundation/Foundation.h>
+#include <dlfcn.h>
+#define nvlog(...) (printf(__VA_ARGS__), printf("\n"))
+#include "nvmtl_readonly_metadata.h"
+#include "nvmtl_physical_bounds.h"
+#include "nvmtl_independent_helpers.h"
+typedef int (*lower_ex_fn)(const uint8_t *, size_t, uint32_t, uint8_t **, size_t *, uint32_t *, char *, size_t);
+typedef void (*free_fn)(uint8_t *, size_t);
+static lower_ex_fn lo; static free_fn fr;
+static NSData *g(NSData *in, uint32_t flags, uint32_t *info)
+{
+    NSData *p = nvmtl_preserve_readonly_metadata(in);
+    uint8_t *out = NULL; size_t n = 0; char err[512] = {0};
+    if (lo(p.bytes, p.length, flags | 2u, &out, &n, info, err, sizeof err)) { printf("lower refused: %s\n", err); return nil; }
+    NSMutableData *r = [NSMutableData dataWithBytes:out length:n]; fr(out, n);
+    int k = nvmtl_relax_physical_bounds(r.mutableBytes, r.length / 4); if (k) printf("relaxed %d\n", k);
+    return nvmtl_independent_helpers(r);
+}
+int main(int argc, char **argv)
+{
+    @autoreleasepool {
+        void *h = dlopen("/Library/GPUBundles/XeMTLDriver.bundle/Contents/MacOS/libxemtl_translate.dylib", RTLD_NOW);
+        lo = (lower_ex_fn)dlsym(h, "nvmtl_lower_buffer_addresses_ex"); fr = (free_fn)dlsym(h, "nvmtl_translate_free");
+        NSData *in = [NSData dataWithContentsOfFile:@(argv[1])];
+        uint32_t info[4] = {0};
+        NSData *d = g(in, 0, info);
+        printf("flags 0: info %u %u %u %u\n", info[0], info[1], info[2], info[3]);
+        if (d && (info[0] || info[2])) { d = g(in, 1, NULL); printf("SAFE module\n"); }
+        if (!d) return 1;
+        [d writeToFile:@(argv[2]) atomically:NO];
+        printf("%zu bytes\n", (size_t)d.length);
+    }
+    return 0;
+}
