+/*
+ * <wtl> §32.16: where a request's time goes after the execbuffer, per caller class (WindowServer vs everyone else):
+ *   dep  queued (eb_request_add) -> ready: its awaits resolved and i915 handed it to the backend (submit_request)
+ *   run  ready -> done (its fence signaled): GuC queueing plus execution, including this context's earlier requests
+ * For each WindowServer request the completions of OTHER callers' requests while it was running are counted: many
+ * means the GPU ran other contexts ahead of it (priority not honoured), none means the time was WindowServer's own.
+ * Fixed pool, no allocation: the record of request rq is slot hash(rq); a busy slot leaves that request untracked.
+ * debug.xegfx_rq prints it (maxes and the slow list restart at every read).
+ */
+extern int xg_fd_xnu_is_compositor(void);
+#define XG_RQ_SLOTS 1024
+struct xg_rq_rec {
+	struct dma_fence_cb cb;
+	struct i915_request *volatile owner;
+	u64 t_add, t_ready;
+	s64 others_at_ready, ws_at_ready;
+	int ws, prio;
+};
+static struct xg_rq_rec xg_rq_pool[XG_RQ_SLOTS];
+enum { XG_RQ_DEP, XG_RQ_RUN, XG_RQ_TOTAL, XG_RQ_STAGES };
+static atomic64_t xg_rq_n[2], xg_rq_sum[2][XG_RQ_STAGES], xg_rq_max[2][XG_RQ_STAGES], xg_rq_over50[2], xg_rq_over100[2];
+static atomic64_t xg_rq_done[2], xg_rq_untracked, xg_rq_noready;
+struct xg_rq_slow { u64 t_ms, dep_us, run_us; s64 others, own; int prio; };
+#define XG_RQ_SLOW 16
+static struct xg_rq_slow xg_rq_slow[XG_RQ_SLOW];
+static atomic_t xg_rq_slow_n;
+static void (*volatile xg_rq_saved_submit)(struct i915_request *rq);
+static DEFINE_SPINLOCK(xg_rq_hook_lock);
+
+static inline unsigned int xg_rq_slot(const struct i915_request *rq)
+{
+	return ((unsigned int)((uintptr_t)rq >> 6) ^ (unsigned int)((uintptr_t)rq >> 16)) & (XG_RQ_SLOTS - 1);
+}
+
+static void xg_rq_max_note(atomic64_t *m, u64 v)
+{
+	if ((s64)v > atomic64_read(m))
+		atomic64_set(m, v);	/* racy by one sample at worst */
+}
+
+/* the render engine's submit_request, wrapped: records when the request became ready */
+static void xg_rq_submit(struct i915_request *rq)
+{
+	struct xg_rq_rec *r = &xg_rq_pool[xg_rq_slot(rq)];
+
+	if (r->owner == rq && !r->t_ready) {
+		r->others_at_ready = atomic64_read(&xg_rq_done[0]);
+		r->ws_at_ready = atomic64_read(&xg_rq_done[1]);
+		r->t_ready = ktime_get_ns();
+	}
+	xg_rq_saved_submit(rq);
+}
+
+static void xg_rq_signaled(struct dma_fence *f, struct dma_fence_cb *cb)
+{
+	struct xg_rq_rec *r = container_of(cb, struct xg_rq_rec, cb);
+	const u64 now = ktime_get_ns();
+	const int c = r->ws ? 1 : 0;
+
+	(void)f;
+	atomic64_inc(&xg_rq_done[c]);
+	if (!r->t_ready) {
+		atomic64_inc(&xg_rq_noready);
+		r->t_ready = r->t_add;
+	}
+	{
+		const u64 dep = r->t_ready - r->t_add, run = now - r->t_ready, tot = now - r->t_add;
+
+		atomic64_inc(&xg_rq_n[c]);
+		atomic64_add(dep, &xg_rq_sum[c][XG_RQ_DEP]); xg_rq_max_note(&xg_rq_max[c][XG_RQ_DEP], dep);
+		atomic64_add(run, &xg_rq_sum[c][XG_RQ_RUN]); xg_rq_max_note(&xg_rq_max[c][XG_RQ_RUN], run);
+		atomic64_add(tot, &xg_rq_sum[c][XG_RQ_TOTAL]); xg_rq_max_note(&xg_rq_max[c][XG_RQ_TOTAL], tot);
+		if (tot > 50 * NSEC_PER_MSEC)
+			atomic64_inc(&xg_rq_over50[c]);
+		if (tot > 100 * NSEC_PER_MSEC)
+			atomic64_inc(&xg_rq_over100[c]);
+		if (c && tot > 50 * NSEC_PER_MSEC) {
+			struct xg_rq_slow *e = &xg_rq_slow[(unsigned int)atomic_inc_return(&xg_rq_slow_n) % XG_RQ_SLOW];
+
+			e->t_ms = now / NSEC_PER_MSEC; e->dep_us = dep / 1000; e->run_us = run / 1000;
+			e->others = atomic64_read(&xg_rq_done[0]) - r->others_at_ready;
+			e->own = atomic64_read(&xg_rq_done[1]) - r->ws_at_ready - 1;
+			e->prio = r->prio;
+		}
+	}
+	WRITE_ONCE(r->owner, NULL);
+}
+
+/* called before __i915_request_commit: starts the record and wraps the render engine's submit_request once */
+static void xg_rq_track(struct i915_request *rq, int prio)
+{
+	struct intel_engine_cs *e = rq->engine;
+	struct xg_rq_rec *r = &xg_rq_pool[xg_rq_slot(rq)];
+	unsigned long fl;
+
+	if (e->class == RENDER_CLASS && !intel_engine_is_virtual(e) && e->submit_request != xg_rq_submit) {
+		spin_lock_irqsave(&xg_rq_hook_lock, fl);
+		if (e->submit_request != xg_rq_submit) {
+			xg_rq_saved_submit = e->submit_request;
+			wmb();
+			WRITE_ONCE(e->submit_request, xg_rq_submit);
+		}
+		spin_unlock_irqrestore(&xg_rq_hook_lock, fl);
+	}
+	if (cmpxchg(&r->owner, NULL, rq) != NULL) {
+		atomic64_inc(&xg_rq_untracked);
+		return;
+	}
+	r->t_ready = 0;
+	r->ws = xg_fd_xnu_is_compositor();
+	r->prio = prio;
+	r->t_add = ktime_get_ns();
+	if (dma_fence_add_callback(&rq->fence, &r->cb, xg_rq_signaled))
+		WRITE_ONCE(r->owner, NULL);	/* already signaled */
+}
