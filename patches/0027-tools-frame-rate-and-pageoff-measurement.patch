+#!/bin/sh
+# ab-probe: fps-probe 1800x1100 for 10 s, twice, with WindowServer's passtime armed; flips/s from the accel and the
+# passtime lines of those runs copied to $1 (docs/page-off-and-compression.md, the CCS A/B).  Needs admin (osascript)
+# to read WindowServer's log, which lives in _windowserver's own TMPDIR.  fps-probe is built next to this script.
+HERE=$(cd "$(dirname "$0")" && pwd)
+OUT=$1; [ -n "$OUT" ] || { echo "usage: $0 out.log"; exit 2; }
+case "$OUT" in /*) ;; *) OUT="$PWD/$OUT" ;; esac
+P=$(pgrep -x WindowServer)
+PT=$(osascript -e "do shell script \"find /private/var/folders -path '*/WindowServer/nvmtl-passtime-$P.log' 2>/dev/null | head -1\" with administrator privileges")
+[ -n "$PT" ] || PT=/dev/null
+L=$(osascript -e "do shell script \"[ -f '$PT' ] && wc -l < '$PT' || echo 0\" with administrator privileges" | tr -d ' ')
+touch /tmp/nvmtl-passtime-request
+for i in 1 2; do
+  f0=$(sysctl -n debug.xegfxaccel_iop_xe_flips); "$HERE/fps-probe" 10 1800 1100 > /dev/null 2>&1
+  f1=$(sysctl -n debug.xegfxaccel_iop_xe_flips); echo "run $i flips/s $(( (f1 - f0) / 10 ))"
+done
+rm -f /tmp/nvmtl-passtime-request
+osascript -e "do shell script \"tail -n +$((L+1)) '$PT' > '$OUT'; chown $(id -u):$(id -g) '$OUT'\" with administrator privileges"
+wc -l < "$OUT"
