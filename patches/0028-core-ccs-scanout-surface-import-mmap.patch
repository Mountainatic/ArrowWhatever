+static int
+xg_scan_add(struct file *filp, void *key, struct xg_drm_bo_scanout *a)
+{
+	struct drm_file *priv = filp->private_data;
+	struct drm_i915_gem_object *obj;
+	struct xg_scan *e;
+	int err;
+
+	if ((obj = i915_gem_object_lookup(priv, a->handle)) == NULL)
+		return -ENOENT;
+	if ((err = i915_gem_object_pin_pages_unlocked(obj)) != 0) {
+		i915_gem_object_put(obj);
+		return err;
+	}
+	if ((e = kzalloc(sizeof(*e), GFP_KERNEL)) == NULL) {
+		i915_gem_object_unpin_pages(obj);
+		i915_gem_object_put(obj);
+		return -ENOMEM;
+	}
+	e->key = key;
+	e->obj = obj;	/* keeps the reference and the page pin */
+	mutex_lock(&xg_scans_lock);
+	if (++xg_scan_next == 0)
+		xg_scan_next = 1;
+	e->token = xg_scan_next;
+	list_add(&e->link, &xg_scans);
+	mutex_unlock(&xg_scans_lock);
+	a->token = e->token;
+	a->size = obj->base.size;
+	return 0;
+}
