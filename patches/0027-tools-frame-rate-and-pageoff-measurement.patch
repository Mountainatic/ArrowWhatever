+#!/bin/bash
+# display-trace.sh start [label] | mark <text> | stop -- record what the display stack does while someone changes
+# modes in System Settings (scaled resolution, refresh rate), locks the screen, sleeps/wakes or plugs a display.
+#   start: snapshot the modes and framebuffer properties, then stream the kernel display log and WindowServer's
+#          CoreDisplay log into data/display-trace-<stamp>-<label>/ in the background
+#   mark:  write a marker line into the trace ("now picking 1920x1200 240 Hz"), so the log can be cut per step
+#   stop:  stop the streams and take the after-snapshot
+# Read-only: nothing here changes a mode, NVRAM or the registry.
+set -uo pipefail
+HERE=$(cd "$(dirname "$0")" && pwd)
+ROOT=$(dirname "$HERE")
+STATE="$ROOT/data/.display-trace-current"
+K='process == "kernel" AND (sender BEGINSWITH "NVRM" OR sender BEGINSWITH "NVAccel" OR sender BEGINSWITH "XeGfx" OR sender BEGINSWITH "IOGraphics" OR sender == "AppleDisplay" OR sender BEGINSWITH "AppleBacklight")'
+W='process == "WindowServer" AND (subsystem BEGINSWITH "com.apple.CoreDisplay" OR subsystem BEGINSWITH "com.apple.SkyLight")'
+
+snap() {
+    local d=$1 tag=$2
+    [ -x "$HERE/display-modes" ] || clang -fobjc-arc -framework CoreGraphics -framework IOKit -framework Foundation \
+        "$HERE/display-modes.m" -o "$HERE/display-modes"
+    "$HERE/display-modes" > "$d/modes-$tag.tsv" 2>&1
+    ioreg -r -c IOFramebuffer -l -w0 > "$d/ioreg-fb-$tag.txt" 2>&1
+    ioreg -r -c AppleDisplay -l -w0 > "$d/ioreg-display-$tag.txt" 2>&1
+    sysctl -a 2>/dev/null | grep -E '^debug\.(nvrm|nv|xegfx)' > "$d/sysctl-$tag.txt"
+    grep -E '^current' "$d/modes-$tag.tsv"
+}
+
+case "${1:-}" in
+start)
+    [ -f "$STATE" ] && { echo "a trace is running: $(cat "$STATE")"; exit 1; }
+    D="$ROOT/data/display-trace-$(date +%Y%m%d-%H%M%S)-${2:-trace}"
+    mkdir -p "$D"
+    snap "$D" before
+    /usr/bin/log stream --predicate "$K" --style compact > "$D/kernel.log" 2>&1 &
+    echo $! > "$D/kernel.pid"
+    /usr/bin/log stream --predicate "$W" --style compact > "$D/windowserver.log" 2>&1 &
+    echo $! > "$D/windowserver.pid"
+    echo "$D" > "$STATE"
+    echo "$(date '+%F %T') start" > "$D/marks.txt"
+    echo "tracing into $D"
+    ;;
+mark)
+    D=$(cat "$STATE" 2>/dev/null) || { echo "no trace running"; exit 1; }
+    shift
+    echo "$(date '+%F %T') $*" | tee -a "$D/marks.txt"
+    snap "$D" "mark$(wc -l < "$D/marks.txt" | tr -d ' ')" > /dev/null
+    ;;
+stop)
+    D=$(cat "$STATE" 2>/dev/null) || { echo "no trace running"; exit 1; }
+    sleep 1
+    for p in kernel windowserver; do kill "$(cat "$D/$p.pid")" 2>/dev/null; rm -f "$D/$p.pid"; done
+    echo "$(date '+%F %T') stop" >> "$D/marks.txt"
+    snap "$D" after
+    rm -f "$STATE"
+    grep -c 'NVRM-fb:' "$D/kernel.log" | sed 's/^/NVRM-fb lines: /'
+    grep -E 'setDisplayMode|validateDetailedTiming|setDetailedTimings|switchMode|applyMode' "$D/kernel.log" | tail -20
+    echo "trace: $D"
+    ;;
+*)
+    echo "usage: $0 start [label] | mark <text> | stop"; exit 2 ;;
+esac
