+int
+xg_i915_gt_min_mhz(int set_mhz)
+{
+	struct pci_dev *pdev = NULL;
+	struct drm_i915_private *i915 = xg_i915_find(&pdev);
+	struct intel_rps *rps;
+	int err;
+
+	if (!i915)
+		return (-ENODEV);
+	rps = &to_gt(i915)->rps;
+	if (set_mhz > 0) {
+		err = intel_rps_set_min_frequency(rps, (u32)set_mhz);
+		pr_info("XEGFX: GT min frequency -> %d MHz: %d (now min %u max %u)\n", set_mhz, err,
+		    intel_rps_get_min_frequency(rps), intel_rps_get_max_frequency(rps));
+		if (err)
+			return (err);
+	}
+	return ((int)intel_rps_get_min_frequency(rps));
+}
