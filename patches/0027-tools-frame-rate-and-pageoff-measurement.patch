+// display-modes: read-only list of every online display and every mode CoreGraphics offers it, HiDPI duplicates
+// included, as tab-separated lines (for the Discrete-mode reference capture and the XeGfx comparison).
+// Build: clang -fobjc-arc -framework CoreGraphics -framework IOKit -framework Foundation display-modes.m -o display-modes
+#import <CoreGraphics/CoreGraphics.h>
+#import <Foundation/Foundation.h>
+#import <IOKit/graphics/IOGraphicsTypes.h>
+
+static void printMode(const char *tag, CGDisplayModeRef m)
+{
+    double hz = CGDisplayModeGetRefreshRate(m);
+    printf("%s\t%zux%zu\t%zux%zu\t%.3f\tid=0x%x\tioflags=0x%x\tusable=%d\thidpi=%d\n", tag,
+           CGDisplayModeGetWidth(m), CGDisplayModeGetHeight(m),
+           CGDisplayModeGetPixelWidth(m), CGDisplayModeGetPixelHeight(m), hz,
+           (unsigned)CGDisplayModeGetIODisplayModeID(m), (unsigned)CGDisplayModeGetIOFlags(m),
+           CGDisplayModeIsUsableForDesktopGUI(m) ? 1 : 0,
+           CGDisplayModeGetPixelWidth(m) > CGDisplayModeGetWidth(m) ? 1 : 0);
+}
+
+int main(void)
+{
+    @autoreleasepool {
+        CGDirectDisplayID ids[16];
+        uint32_t n = 0;
+        if (CGGetOnlineDisplayList(16, ids, &n) != kCGErrorSuccess) return 1;
+        NSDictionary *opts = @{ (__bridge NSString *)kCGDisplayShowDuplicateLowResolutionModes : @YES };
+        for (uint32_t i = 0; i < n; i++) {
+            CGDirectDisplayID d = ids[i];
+            CGSize mm = CGDisplayScreenSize(d);
+            printf("display\t0x%x\tvendor=0x%x\tmodel=0x%x\tserial=0x%x\tbuiltin=%d\tmain=%d\tactive=%d\tmm=%.0fx%.0f\tunit=%u\n",
+                   d, CGDisplayVendorNumber(d), CGDisplayModelNumber(d), CGDisplaySerialNumber(d),
+                   CGDisplayIsBuiltin(d), CGDisplayIsMain(d), CGDisplayIsActive(d), mm.width, mm.height,
+                   CGDisplayUnitNumber(d));
+            CGDisplayModeRef cur = CGDisplayCopyDisplayMode(d);
+            if (cur) { printMode("current", cur); CGDisplayModeRelease(cur); }
+            CFArrayRef modes = CGDisplayCopyAllDisplayModes(d, (__bridge CFDictionaryRef)opts);
+            for (CFIndex k = 0; modes && k < CFArrayGetCount(modes); k++)
+                printMode("mode", (CGDisplayModeRef)CFArrayGetValueAtIndex(modes, k));
+            if (modes) CFRelease(modes);
+        }
+    }
+    return 0;
+}
