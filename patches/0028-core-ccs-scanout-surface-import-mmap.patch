+static struct xg_surfobj *
+xg_surfobj_find(struct drm_i915_gem_object *obj)
+{
+	struct xg_surfobj *so, *found = NULL;
+
+	mutex_lock(&xg_surf_lock);
+	list_for_each_entry(so, &xg_surfobjs, link)
+		if (so->obj == obj) {
+			found = so;
+			break;
+		}
+	mutex_unlock(&xg_surf_lock);
+	return found;
+}
+
+static int
+xg_surf_get_pages(struct drm_i915_gem_object *obj)
+{
+	struct xg_surfobj *so = xg_surfobj_find(obj);
+	struct scatterlist *sg;
+	struct sg_table *st;
+	unsigned int i;
+
+	if (so == NULL)
+		return -ENODEV;
+	st = kmalloc(sizeof(*st), GFP_KERNEL);
+	if (st == NULL)
+		return -ENOMEM;
+	if (sg_alloc_table(st, so->n, GFP_KERNEL)) {
+		kfree(st);
+		return -ENOMEM;
+	}
+	for_each_sg(st->sgl, sg, so->n, i) {
+		sg->offset = 0;
+		sg->length = (unsigned int)so->len[i];
+		sg_dma_address(sg) = (dma_addr_t)so->pa[i];
+		sg_dma_len(sg) = (unsigned int)so->len[i];
+	}
+	__i915_gem_object_set_pages(obj, st);
+	return 0;
+}
+
+static void
+xg_surf_put_pages(struct drm_i915_gem_object *obj, struct sg_table *pages)
+{
+	sg_free_table(pages);
+	kfree(pages);
+}
+
+static void
+xg_surf_release(struct drm_i915_gem_object *obj)
+{
+	struct xg_surfobj *so = NULL, *e;
+
+	mutex_lock(&xg_surf_lock);
+	list_for_each_entry(e, &xg_surfobjs, link)
+		if (e->obj == obj) {
+			list_del(&e->link);
+			so = e;
+			break;
+		}
+	mutex_unlock(&xg_surf_lock);
+	if (so == NULL)
+		return;
+	xg_md_drop(so->md, 1);
+	kvfree(so->pa);
+	kvfree(so->len);
+	kfree(so);
+	xg_surf_frees++;
+	xg_surf_live--;
+}
