+    VkDeviceMemory mem; void *host = NULL;
+    char what[160];
+    if (kind >= 2) {
+        size_t sz = (mr.size + 65535) & ~(size_t)65535;
+        if (posix_memalign(&host, 65536, sz)) exit(1);
+        memset(host, 0x5a, sz);
+        VkMemoryHostPointerPropertiesEXT hp = { VK_STRUCTURE_TYPE_MEMORY_HOST_POINTER_PROPERTIES_EXT };
