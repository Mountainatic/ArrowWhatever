+// a range of `size` aligned to `align` from block a, or UINT64_MAX; with g_arena_mu held
+static uint64_t nvmtl_arena_take_locked(nvmtl_arena *a, uint64_t size, uint64_t align)
+{
+    for (nvmtl_arena_range **pp = &a->free; *pp; pp = &(*pp)->next) {
+        nvmtl_arena_range *r = *pp;
+        const uint64_t at = (r->off + align - 1) & ~(align - 1);
+        if (at + size > r->off + r->size) continue;
+        const uint64_t end = r->off + r->size;
+        if (at > r->off) {   // the head stays free; the tail (if any) follows it
+            const uint64_t head = at - r->off;
+            if (at + size < end) {
+                nvmtl_arena_range *t = malloc(sizeof *t);
+                if (!t) return UINT64_MAX;
+                t->off = at + size; t->size = end - (at + size); t->next = r->next; r->next = t;
+            }
+            r->size = head;
+        } else if (at + size < end) { r->off = at + size; r->size = end - (at + size); }
+        else { *pp = r->next; free(r); }
+        a->live++; a->live_bytes += size;
+        return at;
+    }
