+#!/bin/sh
+# E1 (docs/32-FRAME-RATE.md): WindowServer's XeMTL plugin waits for each composite to finish on the GPU
+# (waitUntilCompleted) unless /private/tmp/xemtl-ws-nowait exists.  XeGfxAccel's deferred flip worker already waits for
+# the GPU before it arms PLANE_SURF (iop_xe_defer=1, iop_xe_wait_idle=1), so that wait only serialises WindowServer
+# against the GPU.  /private/tmp is emptied every boot: recreate the sentinel once the accel's flip ordering is on.
+# The plugin re-reads it every second.  Never creates it while the accel does not order flips after the GPU.
+PATH=/usr/bin:/bin:/usr/sbin:/sbin
+S=/private/tmp/xemtl-ws-nowait
+i=0
+while [ $i -lt 600 ]; do
+    d=$(sysctl -n debug.xegfxaccel_iop_xe_defer 2>/dev/null)
+    w=$(sysctl -n debug.xegfxaccel_iop_xe_wait_idle 2>/dev/null)
+    if [ "$d" = 1 ] && [ "$w" = 1 ]; then
+        touch "$S" && chmod 644 "$S"
+        echo "$(date '+%F %T') sentinel created after ${i}s (defer $d wait_idle $w)"
+        exit 0
+    fi
+    sleep 1
+    i=$((i + 1))
+done
+echo "$(date '+%F %T') accel flip ordering never came on (defer '${d}' wait_idle '${w}'): sentinel not created"
+exit 0
