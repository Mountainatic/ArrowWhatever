+static void nvmtl_arena_give_locked(nvmtl_arena *a, uint64_t off, uint64_t size)
+{
+    nvmtl_arena_range **pp = &a->free;
+    while (*pp && (*pp)->off < off) pp = &(*pp)->next;
+    nvmtl_arena_range *next = *pp, *prev = NULL;
+    for (nvmtl_arena_range *r = a->free; r && r != next; r = r->next) prev = r;
+    if (prev && prev->off + prev->size == off) {   // joins the range before it, and maybe the one after
+        prev->size += size;
+        if (next && prev->off + prev->size == next->off) { prev->size += next->size; prev->next = next->next; free(next); }
+    } else if (next && off + size == next->off) { next->off = off; next->size += size; }
+    else {
+        nvmtl_arena_range *r = malloc(sizeof *r);
+        if (r) { r->off = off; r->size = size; r->next = next; *pp = r; }   // without memory the range is lost, not reused wrongly
+    }
