+
+    VkQueryPoolCreateInfo qi = { VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO, NULL, 0, VK_QUERY_TYPE_TIMESTAMP, 2 * (uint32_t)passes, 0 };
+    VkQueryPool qp; CK(vkCreateQueryPool(dev, &qi, NULL, &qp));
+    cb = begin();
+    vkCmdResetQueryPool(cb, qp, 0, 2 * passes);
+    for (int p = 0; p < passes; p++) {
+        vkCmdWriteTimestamp(cb, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, qp, 2 * p);
+        VkRenderPassBeginInfo rbi = { VK_STRUCTURE_TYPE_RENDER_PASS_BEGIN_INFO, NULL, rp, fb, { { 0, 0 }, { W, H } }, 0, NULL };
